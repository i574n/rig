///- --package .
:# model static =
    :< command_spec_domain.model

:< command_spec_domain.model

:= shim_argv0_code () : i32 = $"rig_legacy_operations::dogfood_shim_argv0_code()"
:= shim_run () : i32 = $"rig_legacy_operations::dogfood_shim_dispatch()"
:= process_verb_code () : i32 = $"KitProcessVerbCode()"
:= process_tail_count () : i32 = $"std::env::args().skip(2).count() as i32"
:= status_ok (migration : i32) : i32 = $"KitStatusOk(!migration)"
:= status_live (migration : i32) : i32 = $"KitStatusLive(!migration)"
:= status_arity_error () : i32 = $"KitStatusArityError()"
:= status_authority_error () : i32 = $"KitStatusAuthorityError()"
:= patch_run () : i32 = $"KitPatchAdapter()"
:= agile_run () : i32 = $"KitAgileAdapter()"
:= bundle_run () : i32 = $"KitBundleAdapter()"
:= proxy_run () : i32 = $"KitProxyAdapter()"
:= help_rejected () : i32 = $"KitHelpRejected()"
:= unknown_rejected () : i32 = $"KitUnknownRejected()"

:= migration_status () : i32 = $"bootstrap_authority_status::rig_bootstrap_settled_migration_status()"
:= workspace_state_status () : i32 = $"bootstrap_authority_status::rig_bootstrap_workspace_state_status()"
:= compiler_session_status () : i32 = $"bootstrap_authority_status::rig_bootstrap_compiler_session_status()"
:= legacy_bundle_writer_status () : i32 = $"bootstrap_authority_status::rig_bootstrap_legacy_bundle_writer_status()"
:= ingest_frontier_status () : i32 = $"bootstrap_authority_status::rig_bootstrap_ingest_frontier_status()"
:= process_batch_status () : i32 = $"process_batch_plan_domain::rig_batch_matrix_auto_chain_budget(60000, 16000)"

:= run_status () : i32 =
    ?= process_tail_count () ?|
    | 0 => rig_status_facts.facts.status_printed (".", "")
    | 1 => status_live 0i32
    | _ => status_arity_error ()

:= run_public_verb () : i32 =
    ?= command_catalog_witness () ?|
    | 1 =>
        ?= handler_from_code (process_verb_code ()) ?|
        | StatusHandler => run_status ()
        | PatchHandler => patch_run ()
        | AgileHandler => agile_run ()
        | BundleHandler => bundle_run ()
        | ProxyHandler => proxy_run ()
        | HelpHandler => help_rejected ()
        | UnknownHandler => unknown_rejected ()
        | LeaseDeniedHandler => 2i32
    | _ => 2i32

:= job_run () : i32 = $"rig_job_entry::rig_job_run()" : i32

:= read_run () : i32 = $"rig_read_query::rig_read_run()" : i32
:= grep_run () : i32 = $"rig_grep_query::rig_grep_run()" : i32
:= do_run () : i32 = $"rig_do::rig_do_run()" : i32
:= process_run () : i32 = $"rig_process_table::rig_process_run()" : i32
:= standards_run () : i32 = $"rig_standards::rig_standards_run()" : i32
:= window_run () : i32 = $"rig_machine_windows::rig_window_run()" : i32
:= experiment_run () : i32 = $"rig_experiments::rig_experiment_run()" : i32
:= guide_run () : i32 = $"rig_guide::rig_guide_run()" : i32
:= machine_run () : i32 = $"rig_machine_watch::rig_machine_watch_run()" : i32
:= adoption_run () : i32 = $"rig_adoption::rig_adoption_run()" : i32
:= memory_run () : i32 = $"rig_memory::rig_memory_run()" : i32
:= resume_run () : i32 = $"rig_resume::rig_resume_run()" : i32
:= ci_run () : i32 = $"rig_ci_parity::rig_ci_parity_run()" : i32
:= os_launch_run () : i32 = $"rig_os_launch::rig_process_launch_run()" : i32
:= crate_run () : i32 = $"rig_crate_gate::rig_crate_gate_run()" : i32
:= env_run () : i32 = $"rig_env_pins::rig_env_run()" : i32
:= mirror_run () : i32 = $"rig_mirror::rig_mirror_run()" : i32
:= evidence_run () : i32 = $"rig_evidence::rig_evidence_run()" : i32
:= lint_run () : i32 = $"rig_lint_cli::rig_lint_cli_run()" : i32
:= schedule_run () : i32 = $"rig_schedule::rig_schedule_run()" : i32

:~ direct_help (~usage : string) : i32 =
    $'println\!("usage: kit {}", &*!usage)' : ()
    0i32

:< command_spec_domain.direct_verbs
:~ ceremony_routed (~word : string) : i32 =
    := subcommand = argument_file.process_argument 2i32
    ? $'rig_ceremonies::rig_ceremony_admits(&*!word, &*!subcommand)' : bool ?> agile_run () |: 2i32

:| direct_parse =
    | DirectKnown : direct_verb
    | DirectUnknown

:= direct_word (verb : direct_verb) : string = union_reflection.cases.union_case_kebab "Verb" verb

:~ direct_of (~word : string) : direct_parse =
    union_reflection.cases.union_case_where
        \ (verb : direct_verb) => word = direct_word verb
        \ verb => DirectKnown verb
        DirectUnknown

:= direct_routed (verb : direct_verb) : i32 =
    ?= verb ?|
    | VerbJob => job_run ()
    | VerbRepo => rig_cli_routes.routes.repo_routed ()
    | VerbTable => rig_cli_routes.routes.table_routed ()
    | VerbRead => read_run ()
    | VerbLines => read_run ()
    | VerbGrep => grep_run ()
    | VerbDo => do_run ()
    | VerbPs => process_run ()
    | VerbKill => process_run ()
    | VerbStandards => standards_run ()
    | VerbWindow => window_run ()
    | VerbExperiment => experiment_run ()
    | VerbGuide => guide_run ()
    | VerbMachine => machine_run ()
    | VerbAdoption => adoption_run ()
    | VerbMemory => memory_run ()
    | VerbResume => resume_run ()
    | VerbCi => ci_run ()
    | VerbProcess => os_launch_run ()
    | VerbCrate => crate_run ()
    | VerbEnv => env_run ()
    | VerbMirror => mirror_run ()
    | VerbBacklog => ceremony_routed "backlog"
    | VerbStory => ceremony_routed "story"
    | VerbStandup => ceremony_routed "standup"
    | VerbEvidence => evidence_run ()
    | VerbLint => lint_run ()
    | VerbSchedule => schedule_run ()
    | VerbHeal => rig_heal_nameof.heal.heal_run ()
    | VerbHook => rig_hook.hook.hook_run ()
    | VerbRun => rig_run_cli.run.run_run ()
    | VerbMetrics => rig_exec_export.export.export_run ()

:= run_direct () : i32 =
    := verb = argument_file.process_argument 1i32
    := target = argument_file.process_argument 2i32
    := usage = ? verb = "help" ?> $'command_spec_domain::rig_direct_verb_usage(&*!target)' : string |: ""
    ? usage <> "" ?> direct_help usage
    |:
        ?= direct_of verb ?|
        | DirectKnown known => direct_routed known
        | DirectUnknown =>
            ?= shim_argv0_code () ?|
            | 0 => run_public_verb ()
            | _ => shim_run ()

:= run () : i32 = argument_file.run_from (argument_file.argument_source ()) run_direct
:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail

:= known_word (~word : string) : bool =
    ?= direct_of word ?|
    | DirectKnown _ => !+
    | DirectUnknown => !-

///> rust
:# direct_verbs_parse_from_their_case_names =
    expect
        (known_word "job" && known_word "experiment" && known_word "ps" && known_word "grep")
        "every direct verb word comes from its case name"
    expect (known_word "JOB" = !-) "verbs stay lowercase"
    expect (known_word "agile" = !-) "agile stays on the public verb route"
    expect (known_word "" = !-) "an empty verb is not direct"

:= verb_word (verb : direct_verb) : string = direct_word verb

///> rust
:# every_direct_verb_has_a_help_line =
    := missing =
        union_reflection.cases.union_cases_fold
            \ found (verb : direct_verb) =>
                ? command_spec_domain.model.direct_verb_usage (verb_word verb) = "" ?> found + 1i32 |: found
            0i32
    expect (missing = 0i32) "every direct verb word has a line in the command spec usages, so kit help <verb> answers"
    := misnamed =
        union_reflection.cases.union_cases_fold
            \ found (verb : direct_verb) => ? verb_word verb = (verb_help_of verb).word ?> found |: found + 1i32
            0i32
    expect (misnamed = 0i32) "each help word is its verb's case name, so kit help <word> and kit <word> agree"
