:= main () : i32 =
    export "rig_retention_series_error" ((\ current => series.series_error current) : string -> string)
    export "rig_retention_series_prefix" ((\ current => series.series_prefix current) : string -> string)
    export "rig_retention_series_alpha" ((\ current => series.series_alpha current) : string -> u64)
    export "rig_retention_receipt_error" ((\ text => receipt_read.receipt_error text) : string -> string)
    export "rig_retention_receipt_row" ((\ text => receipt_read.receipt_row text) : string -> string)
    export
        "rig_retention_receipt_source"
        (
            \ (fingerprint, current, candidates, deletes, remaining, status) =>
                receipt.receipt_source fingerprint current candidates deletes remaining status
            : string * string * u64 * u64 * u64 * string -> string
        )
    global "#![allow(clippy::collapsible_if)]"
    emit_runtime ()
    0i32
