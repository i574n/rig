///- --package .
:# lint_cli static =
    :< sm'_operators

:< sm'_operators

:= summary_line (checks : i32) (items : i32) (elapsed : u64) : string =
    sm'.concat_list "" [
        "rig agile lint ok failing_items="; sm'.show items; " failing_checks="; sm'.show checks
        " (report only; legacy items ratchet) elapsed_ms="; sm'.show elapsed
    ]

:~ ^ distinct_ids
    (rows : array_base agile_quality_lint.lint.failure_row) (at : i32) (~last : string) (n : i32)
    : i32
    =
    ? at >= am'.length_base rows
    ?> n
    |:
        := id = (am'.index_base at rows).id
        distinct_ids rows (at + 1i32) id (? id = last ?> n |: n + 1i32)

:~ ^ printed (rows : array_base agile_quality_lint.lint.failure_row) (at : i32) : () =
    ? at < am'.length_base rows ?>
        := row = am'.index_base at rows
        console.write_line (row.id ++# " " ++# row.status ++# " " ++# row.check)
        printed rows (at + 1i32)
    |: ()

:~ ^ census_printed (rows : array_base agile_quality_state.state_rows.census_row) (at : i32) : () =
    ? at < am'.length_base rows ?>
        := row = am'.index_base at rows
        console.write_line ("rig agile lint census check=" ++# row.check ++# " items=" ++# sm'.show row.items)
        census_printed rows (at + 1i32)
    |: ()

:~ state_text (~root : string) : string =
    agile_state_fs.model.read_state (sm'.replace "\\" "/" root ++# "/state/agile.spi")

:~ lint_run () : i32 =
    := started = workspace_primitives.clock.unix_ms ()
    ?= env.command_line_arguments () ?|
    | _ :: _ :: root :: flag :: _ ?& flag = "--census" =>
        census_printed (agile_quality_state.state_rows.census_text_of (state_text root)) 0i32
        console.write_line ("rig agile lint census ok elapsed_ms=" ++# sm'.show (workspace_primitives.clock.ms_since started))
        0i32
    | _ :: _ :: root :: rest ?& sm'.starts_with "-" root |> not =>
        := team = ?= rest ?| | flag :: value :: _ ?& flag = "--team" => value | _ => ""
        := rows = agile_quality_state.state_rows.team_failures_of (state_text root, team)
        printed rows 0i32
        := elapsed = workspace_primitives.clock.ms_since started
        console.write_line (summary_line (am'.length_base rows) (distinct_ids rows 0i32 "" 0i32) elapsed)
        0i32
    | _ =>
        console.write_error_line ("usage: rig agile lint <root> [--census | --team <team>] elapsed_ms=" ++# sm'.show (workspace_primitives.clock.ms_since started))
        2i32

///> rust
:# the_summary_names_items_and_checks =
    := expected = "rig agile lint ok failing_items=2 failing_checks=3 "
    testing.expect (sm'.starts_with expected (summary_line 3i32 2i32 7u64)) (summary_line 3i32 2i32 7u64)
    testing.expect (sm'.ends_with " elapsed_ms=7" (summary_line 3i32 2i32 7u64)) "the summary ends with the elapsed time"
:= main () : i32 =
    export "rig_agile_lint_run" lint_run
    0i32
