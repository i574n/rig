///- --package .
:# rules static =
    :< sm'_operators
    :< workspace_primitives.bytes

:< sm'_operators
:< workspace_primitives.bytes

:| standard =
    | NoCommentLines
    | LineWidth : i32
    | LfOnly
    | IntegerOnly : string
    | TestTargets
    | HostFree
    | LibReferenced

:| ^ standards =
    | NoStandards
    | StandardThen : standard * standards

:| line_kind =
    | BlankLine
    | CodeLine
    | DirectiveLine
    | TodoLine
    | CommentLine

:== file_scan =
    {
        findings : string
        count : i32
        in_todo : bool
        last_code : string
        seen_test : bool
        notebook_header : bool
    }

:= todo_marker () : string = "TO" ++# "DO"

:= trimmed_start (~line : string) : string = $'std::rc::Rc::<str>::from((!line).trim_start())' : string
:= char_count (~line : string) : i32 = $'(!line).trim_end_matches(char::from(13u8)).chars().count() as i32' : i32
:= i32_text (value : i32) : string = (sm'.show value)

:= line_kind_of (~line : string) : line_kind =
    := lead = trimmed_start line
    ? lead = "" || lead = "\r"
    ?> BlankLine
    |? sm'.starts_with "///" lead ?> DirectiveLine
    |? sm'.starts_with "//" lead ?> (? sm'.contains (todo_marker ()) lead ?> TodoLine |: CommentLine)
    |: CodeLine

:= standard_word (value : standard) : string = union_reflection.cases.union_case_kebab "" value

:= default_standards () : standards =
    StandardThen (NoCommentLines, StandardThen (LineWidth 120i32, StandardThen (LfOnly, StandardThen (TestTargets,
        NoStandards))))

:= row_value (~row : string) (~case : string) : string =
    $'std::rc::Rc::<str>::from((!row).split_once(&*!case).map(|(_, \
        rest)| rest.trim().trim_end_matches("u32").trim_end_matches("i32").trim_matches(char::from(34u8))).unwrap_or("\
        "))' : string

:= line_head (~text : string) : string = sm'.first_line text
:= line_rest (~text : string) : string = sm'.after_first_line text

:| declared_row =
    | DeclaredRule : standard
    | UnknownRule : string
    | NotARule

:= declaration_row (~row : string) : bool =
    sm'.starts_with "inl " row || sm'.starts_with "let " row || sm'.starts_with ":= " row || sm'.starts_with ":~ " row

:~ declared_row_of (~row : string) : declared_row =
    ? declaration_row row = !-
    ?> NotARule
    |? sm'.contains "= NoCommentLines" row
    ?> DeclaredRule NoCommentLines
    |? sm'.contains "= LfOnly" row
    ?> DeclaredRule LfOnly
    |? sm'.contains "= TestTargets" row
    ?> DeclaredRule TestTargets
    |? sm'.contains "= HostFree" row
    ?> DeclaredRule HostFree
    |? sm'.contains "= LibReferenced" row ?> DeclaredRule LibReferenced
    |? sm'.contains "= LineWidth " row ?> DeclaredRule (LineWidth ($'(!(row_value row "= LineWidth ")).parse::<i32>().\
        unwrap_or(120)' : i32))
    |? sm'.contains "= IntegerOnly " row ?> DeclaredRule (IntegerOnly (row_value row "= IntegerOnly "))
    |? sm'.contains "() = " row && sm'.contains ") : " row = !- ?> UnknownRule (row_value row "() = ")
    |: NotARule

:~ ^ declared_from (~text : string) (found : standards) : standards =
    ? text = ""
    ?> found
    |:
        ?= declared_row_of (line_head text) ?|
        | DeclaredRule rule => declared_from (line_rest text) (StandardThen (rule, found))
        | _ => declared_from (line_rest text) found

:~ ^ unknown_rules (~text : string) (~path : string) (number : i32) (~found : string) : string =
    ? text = ""
    ?> found
    |:
        := next = line_rest text
        ?= declared_row_of (line_head text) ?|
        | UnknownRule name =>
            unknown_rules next path
                (number + 1i32)
                (
                    found
                    ++# path
                    ++# ":"
                    ++# i32_text number
                    ++# ("  unknown-rule  " ++# name ++# " is not a rule this kit knows, so it never runs" ++# "\n")
                )
        | _ => unknown_rules next path (number + 1i32) found

:= finding (~path : string) (number : i32) (rule : standard) (~detail : string) : string =
    path ++# ":" ++# (i32_text number) ++# "  " ++# ((standard_word rule) ++# "  " ++# detail ++# "\n")

:= floating (~line : string) : bool = $'{ let line = &*!line; line.contains("f64") || line.contains("f32") }' : bool

:~ ^ outside_quotes (pieces : array string) (index : i32) (kept : string) : string =
    ? am'.length pieces <= index
    ?> kept
    |: outside_quotes pieces (index + 2i32) (kept ++# " " ++# am'.index index pieces)

:~ unquoted (~line : string) : string = outside_quotes (sm'.split "\"" line |> array) 0i32 ""

:~ stray_target (~previous : string) (~line : string) (kind : line_kind) : bool =
    := lead = trimmed_start line
    := retired = previous = "///> _" || sm'.starts_with "///> _ " previous
    := after_target = sm'.starts_with "///> " previous && retired |> not
    := test_head = sm'.starts_with ":# " line || sm'.starts_with "test " line
    := runs = test_head && sm'.contains " static =" line |> not
    ?= kind ?|
    | BlankLine => !-
    | _ => after_target && runs |> not && sm'.starts_with "///> " lead |> not

:~ line_findings
    (rule : standard) (~path : string) (~module : string) (number : i32) (~line : string) (kind : line_kind)
    (scan : file_scan)
    : string
    =
    ?= rule ?|
    | NoCommentLines =>
        ?= kind ?|
        | CommentLine =>
            ? scan.in_todo ?> "" |: finding path number rule "a comment line; encode it in names or drop it"
        | _ => ""
    | LineWidth width =>
        := count = char_count line
        ? width < count ?> finding path number rule ((i32_text count) ++# " columns, limit " ++# (i32_text width)) |: ""
    | LfOnly => ? sm'.ends_with "\r" line ?> finding path number rule "CRLF line ending" |: ""
    | IntegerOnly name =>
        ?= kind ?|
        | CodeLine =>
            ? name = module && floating line
            ?> finding path number rule "floating point in an integer-only module"
            |: ""
        | _ => ""
    | TestTargets =>
        := test_head = sm'.starts_with ":# " line || sm'.starts_with "test " line
        := test_line = test_head && sm'.contains " static =" line = !-
        := directive = trimmed_start line
        ? directive = "///> _" || sm'.starts_with "///> _ " directive
        ?>
            finding path number rule (
                "///> _ is retired: Cells infers the cells that never run (a file with tests never runs its main, "
                ^^ "nor does an export-only or backend-dispatching main); delete the line"
            )
        |? test_line && scan.seen_test = !- && scan.notebook_header = !- ?>
            finding path number rule (
                "a test block in a module without a notebook header never runs; start the file with "
                ^^ "///- --package . and a :# <module> static = prelude"
            )
        |? sm'.starts_with "///-" directive && sm'.contains " -d " (directive ++# " ")
        ?> finding path number rule "crates on a ///- package line; put -d on each test's own ///> line"
        |? test_line && sm'.starts_with "///> " scan.last_code = !-
        ?> finding path number rule "test block without its own ///> target line directly above it"
        |? stray_target scan.last_code line kind && test_head && sm'.contains " static =" line
        ?> finding path number rule "a ///> target above a static block; static blocks carry no target"
        |? stray_target scan.last_code line kind
        ?> finding path number rule "a ///> target not directly above a test block; targets sit on each test"
        |: ""
    | HostFree =>
        ?= kind ?|
        | CodeLine =>
            ? sm'.contains "$'" (unquoted line) ?>
                finding path number rule (
                    "a host macro in a host-free package; reach for lib/spiral (sm', am', listm', file_system) or "
                    ^^ "the OS boundary package"
                )
            |: ""
        | _ => ""
    | LibReferenced => ""

:~ ^ rules_applied
    (list : standards) (~path : string) (~module : string) (number : i32) (~line : string) (kind : line_kind)
    (scan : file_scan) (~found : string)
    : string
    =
    ?= list ?|
    | NoStandards => found
    | StandardThen (rule, rest) =>
        rules_applied rest path module number line kind scan (
            found ++# (line_findings rule path module number line kind scan)
        )

:= findings_count (~text : string) : i32 = $'(!text).lines().count() as i32' : i32

:~ ^ lines_scanned
    (list : standards) (~path : string) (~module : string) (~text : string) (number : i32) (scan : file_scan)
    : file_scan
    =
    ? text = ""
    ?> scan
    |:
        := line = line_head text
        := kind = line_kind_of line
        := found = rules_applied list path module number line kind scan ""
        := in_todo =
            ?= kind ?|
            | TodoLine => !+
            | CommentLine => scan.in_todo
            | _ => !-
        := last_code =
            ?= kind ?|
            | BlankLine => scan.last_code
            | _ => trimmed_start line
        := seen_test = scan.seen_test || (sm'.starts_with ":# " line && sm'.contains " static =" line = !-)
        := static_prelude = sm'.starts_with ":# " line && sm'.contains " static =" line
        := package_line = sm'.starts_with "///-" (trimmed_start line)
        := after_target = number = 2i32 && sm'.starts_with "///> " scan.last_code
        := notebook_header = scan.notebook_header || (package_line && (number = 1i32 || after_target)) || static_prelude
        := next =
            {
                findings = scan.findings ++# found
                count = scan.count + findings_count found
                in_todo = in_todo
                last_code = last_code
                seen_test = seen_test
                notebook_header = notebook_header
            }
        lines_scanned list path module (line_rest text) (number + 1i32) next

:~ file_scan_start () : file_scan =
    {
        findings = ""
        count = 0i32
        in_todo = !-
        last_code = ""
        seen_test = !-
        notebook_header = !-
    }


:= scanned_text (list : standards) (~module : string) (~text : string) : string =
    (lines_scanned list "m.spi" module text 1i32 (file_scan_start ())).findings

///> rust
:# comments_fail_but_todo_blocks_and_directives_pass =
    := text = "///> rust\ninl a = 1\n// stray note\n// TODO: KIT-X wire it\n//     continuation\ninl b = 2\n"
    testing.expect
        (
            scanned_text (StandardThen (NoCommentLines, NoStandards)) "m" text
            = "m.spi:3  no-comment-lines  a comment line; encode it in names or drop it\n"
        )
        (scanned_text (StandardThen (NoCommentLines, NoStandards)) "m" text)

///> rust
:# widths_crlf_floats_and_test_targets_are_flagged =
    := list =
        StandardThen (LineWidth 10i32, StandardThen (LfOnly, StandardThen (IntegerOnly "m", StandardThen (TestTargets,
            NoStandards))))
    := text = "inl short = 1\r\ninl x = 1.0f64\n\n///> rust\ntest fine =\ntest bare =\ntest m static =\n"
    := found = scanned_text list "m" text
    testing.expect (sm'.contains "m.spi:1  line-width  13 columns, limit 10" found) found
    testing.expect (sm'.contains "m.spi:1  lf-only  CRLF line ending" found) found
    testing.expect (sm'.contains "m.spi:2  integer-only  floating point in an integer-only module" found) found
    testing.expect (sm'.contains "m.spi:6  test-targets" found) found
    testing.expect (sm'.contains "m.spi:5  test-targets  test block without" found = !-) found
    := expected = "m.spi:5  test-targets  a test block in a module without a notebook header"
    testing.expect (sm'.contains expected found) found
    testing.expect (sm'.contains "m.spi:7  test-targets" found = !-) found
    testing.expect
        ((scanned_text list "other" "inl x = 1.0f64\n") = "m.spi:1  line-width  14 columns, limit 10\n")
        "integer-only is per module"

///> rust
:# a_main_after_a_test_block_needs_no_marker =
    := list = StandardThen (TestTargets, NoStandards)
    := head = "///- --package .\n:# m static =\n\n"
    := tested = "///> rust\n:# works =\n    ()\n\n"
    := entry = ":= main () : i32 =\n    0i32\n"
    := trailing = scanned_text list "m" (head ++# tested ++# entry)
    testing.expect (trailing = "") trailing
    := leading = scanned_text list "m" (head ++# entry ++# "\n" ++# tested)
    testing.expect (leading = "") leading

///> rust
:# the_retired_skip_marker_is_flagged =
    := list = StandardThen (TestTargets, NoStandards)
    := tested = "///- --package .\n:# m static =\n\n///> rust\n:# works =\n    ()\n\n"
    := marked = scanned_text list "m" (tested ++# "///> _\n:= main () : i32 =\n    0i32\n")
    testing.expect (sm'.contains "m.spi:8  test-targets  ///> _ is retired" marked) marked
    := prelude = scanned_text list "m" ("///- --package .\n///> _\n:# m static =\n")
    testing.expect (sm'.contains "m.spi:2  test-targets  ///> _ is retired" prelude) prelude

///> rust
:# a_test_block_needs_a_notebook_header_to_run =
    := list = StandardThen (TestTargets, NoStandards)
    := flagged = "a test block in a module without a notebook header"
    := tests = "///> rust\n:# works =\n    ()\n\n///> rust\n:# also =\n    ()\n"
    := headerless = scanned_text list "m" (":< sm'_operators\n\n" ++# tests)
    testing.expect (sm'.contains ("m.spi:4  test-targets  " ++# flagged) headerless) headerless
    testing.expect (findings_count headerless = 1i32) "one finding per file, at the first test block"
    := headed = scanned_text list "m" ("///- --package .\n:# m static =\n\n" ++# tests)
    testing.expect (sm'.contains flagged headed = !-) "a notebook header"
    := lib_style = scanned_text list "m" (":# m static =\n    :< base\n\n" ++# tests)
    testing.expect (sm'.contains flagged lib_style = !-) "a static prelude runs with its package as context"
    := target_first = scanned_text list "m" ("///> zig\n///- --package ../rig_cli_check\n:< cli\n\n" ++# tests)
    testing.expect (sm'.contains flagged target_first = !-) "a file target on line 1 above the package header"
    testing.expect (sm'.contains flagged (scanned_text list "m" ":< sm'_operators\n:= f () = 1i32\n") = !-) "no tests"

///> rust
:# declared_rows_replace_the_defaults =
    := declared =
        declared_from
            (
                "union standard =\n    | LineWidth :: u32 -> standard\ninl width () = LineWidth 100u32\n"
                ^^ "inl ints () = IntegerOnly \"model\"\n"
            )
            NoStandards
    := found = scanned_text declared "model" "inl f = 2.5f64\n"
    testing.expect (sm'.contains "integer-only" found) found
    testing.expect (sm'.contains "line-width" found = !-) found
    := dialect =
        declared_from
            ":= width () = LineWidth 100u32\n:= ints () = IntegerOnly \"model\"\n:= host () = HostFree\n"
            NoStandards
    := found3 = scanned_text dialect "model" "inl f = 2.5f64\n"
    testing.expect (sm'.contains "integer-only" found3) "an i574n dialect := row declares a rule"

///> rust
:# host_free_flags_host_macros_and_rows_declare_it =
    := declared = declared_from "inl host () = HostFree\ninl lib () = LibReferenced\n" NoStandards
    := found =
        scanned_text declared
            "m"
            "inl up (~t : string) : string = $'x' : string\ninl ok = sm'.to_upper t\n// $'x' in prose\n"
    testing.expect (sm'.contains "m.spi:1  host-free  a host macro in a host-free package" found) found
    testing.expect (sm'.contains "m.spi:2" found = !-) found
    testing.expect (sm'.contains "m.spi:3" found = !-) "a comment that mentions a macro is not one"
    := quoted = scanned_text declared "m" "inl opener = \"$'\"\ninl hosted = sm'.replace \"@'\" \"$'\" t\n"
    testing.expect (quoted = "") "a macro opener inside a string literal is text, not a macro"

///> rust
:# a_declared_rule_this_kit_does_not_know_is_a_finding =
    := text = "inl width () = LineWidth 100u32\ninl future () = ShinyRule\ninl helper = 1\n"
    testing.expect
        (
            unknown_rules text "p/standards.spi" 1i32 ""
            = "p/standards.spi:2  unknown-rule  ShinyRule is not a rule this kit knows, so it never runs\n"
        )
        (unknown_rules text "p/standards.spi" 1i32 "")
    testing.expect
        (unknown_rules "inl host () = HostFree\ninl lib () = LibReferenced\n" "s" 1i32 "" = "")
        "known rules are no finding"
    testing.expect
        (
            unknown_rules ":= future () = ShinyRule\n" "p/standards.spi" 1i32 ""
            = "p/standards.spi:1  unknown-rule  ShinyRule is not a rule this kit knows, so it never runs\n"
        )
        "an unknown i574n dialect rule is a finding too"
    testing.expect
        (unknown_rules "inl stdout_line (~text : string) : () = $'println'\n" "s" 1i32 "" = "")
        "a typed unit function in a module named standards.spi is no declaration"

///> rust
:# targets_sit_on_each_test_and_header_or_static_targets_are_flagged =
    := list = StandardThen (TestTargets, NoStandards)
    := headed =
        "///- --package .\n///> rust\n///> gleam\ntest m static =\n    open sm'_operators\n\ntest bare =\n"
        ^^ "    inl a = 1\n"
    := found = scanned_text list "m" headed
    testing.expect (sm'.contains "m.spi:4  test-targets  a ///> target above a static block" found) found
    testing.expect (sm'.contains "m.spi:7  test-targets  test block without its own ///> target" found) found
    := per_test = "///- --package .\ntest m static =\n    open sm'_operators\n\n///> rust\n///> gleam\ntest bare =\n"
    testing.expect (scanned_text list "m" per_test = "") (scanned_text list "m" per_test)
    := header = scanned_text list "m" "///> zig\n///- --package .\n:# m static =\n"
    testing.expect (sm'.contains "m.spi:2  test-targets  a ///> target not directly above a test block" header) header

///> rust
:# crates_belong_on_each_test_never_in_a_manifest_or_header =
    := list = StandardThen (TestTargets, NoStandards)

    := header = scanned_text list "m" "///- --package . -d regex\n:# m static =\n"
    testing.expect (sm'.contains "m.spi:1  test-targets  crates on a ///- package line" header) header
    := per_test = "///- --package .\n:# m static =\n    ()\n\n///> rust -d chrono regex\n:# works =\n    ()\n"
    testing.expect (scanned_text list "m" per_test = "") (scanned_text list "m" per_test)
