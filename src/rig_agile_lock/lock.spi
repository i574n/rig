///- --package .
:< sm'_operators

:~ lock_directory_claimed (~path : string) : bool = $'std::fs::create_dir(&*!path).is_ok()' : bool

:~ lock_directory_removed (~path : string) : () = $'{ let _ = std::fs::remove_dir(&*!path); }' : ()

:~ state_lock_path (~root : string) : string = root ++# "/state/agile.spi.lock"

:~ lock_holder_path (~root : string) : string = state_lock_path root ++# "/holder"

:~ lock_holder_text (pid : u64) (started : u64) : string = sm'.show pid ++# " " ++# sm'.show started

:~ lock_number (~text : string) : u64 = optionm'.default_value 0u64 (convert.try_convert (sm'.trim text))

:~ holder_stale_by (alive : u64 -> bool) (~holder : string) (now : u64) : bool =
    := space = sm'.index_of " " holder
    ? space < 0i32
    ?> !+
    |:
        := pid = lock_number (sm'.substring 0i32 space holder)
        := started = lock_number (sm'.substring (space + 1i32) ((sm'.length holder : i32) - space - 1i32) holder)
        pid = 0u64 || now > started + 600000u64 || alive pid |> not

:~ lock_holder_stale (~holder : string) (now : u64) : bool =
    holder_stale_by (\ (pid : u64) => rig_process_alive.alive.process_alive pid) holder now

:~ state_lock_cleared (~root : string) : () =
    file_system.file_delete (lock_holder_path root)
    lock_directory_removed (state_lock_path root)

:~ ^ state_lock_waited (~root : string) (deadline : u64) (unread : i32) : bool =
    ? lock_directory_claimed (state_lock_path root) ?>
        := pid : u64 = convert.convert (rig_os_process.process.own_pid ())
        := started = workspace_primitives.clock.unix_ms ()
        file_system.write_all_text (lock_holder_path root) (lock_holder_text pid started)
        !+
    |? file_system.directory_exists (root ++# "/state") |> not
    ?> !+
    |:
        := holder = file_system.read_text_or_empty (lock_holder_path root)
        := unwritten = holder = "" || sm'.index_of " " holder < 0i32
        ? unwritten && unread < 400i32 ?>
            threading.rust_sleep_ms 25u64
            state_lock_waited root deadline (unread + 1i32)
        |? lock_holder_stale holder (workspace_primitives.clock.unix_ms ()) ?>
            state_lock_cleared root
            state_lock_waited root deadline 0i32
        |? workspace_primitives.clock.unix_ms () >= deadline
        ?> !-
        |:
            threading.rust_sleep_ms 25u64
            state_lock_waited root deadline 0i32

:= inherited_key () : string = "KIT_AGILE_LOCK_HOLDER"

:~ held_by_ancestor (~root : string) : bool =
    := inherited = env.get_environment_variable (inherited_key ())
    := own : u64 = convert.convert (rig_os_process.process.own_pid ())
    := holder = file_system.read_text_or_empty (lock_holder_path root)
    inherited <> "" && inherited <> sm'.show own && sm'.starts_with (inherited ++# " ") holder

:~ os_lock_path (~root : string) : string =
    $'std::rc::Rc::<str>::from({ let state = std::path::Path::new(&*!root).join("state"); \
        let canonical = std::fs::canonicalize(&state).unwrap_or(state); \
        let mut hash: u64 = 0xcbf29ce484222325; \
        for byte in canonical.to_string_lossy().to_lowercase().bytes() { \
            hash ^= byte as u64; hash = hash.wrapping_mul(0x100000001b3); } \
        let dir = std::env::temp_dir().join("rig-agile-locks"); let _ = std::fs::create_dir_all(&dir); \
        dir.join(format\!("{:016x}.lock", hash)).to_string_lossy().into_owned() })' : string

:~ os_lock_taken (~path : string) (wait_ms : u64) : bool =
    $'{ let deadline = std::time::Instant::now() + std::time::Duration::from_millis(!wait_ms); \
        let mark = format\!("{} {}", std::process::id(), &*!path); \
        if std::env::var("RIG_AGILE_OSLOCK").ok().as_deref() == Some(mark.as_str()) { true } else { \
        match std::fs::OpenOptions::new().create(true).read(true).write(true).open(&*!path) { \
            Err(_) => true, \
            Ok(file) => loop { match file.try_lock() { \
                Ok(()) => { std::mem::forget(file); \
                    unsafe { std::env::set_var("RIG_AGILE_OSLOCK", &mark) }; break true } \
                Err(std::fs::TryLockError::WouldBlock) if std::time::Instant::now() < deadline => \
                    std::thread::sleep(std::time::Duration::from_millis(10)), \
                Err(_) => break false } } } } }' : bool

:~ lock_taken (~root : string) : bool =
    ? held_by_ancestor root
    ?> !+
    |? os_lock_taken (os_lock_path root) 300000u64 |> not
    ?> !-
    |? state_lock_waited root (workspace_primitives.clock.unix_ms () + 300000u64) 0i32 ?>
        := own : u64 = convert.convert (rig_os_process.process.own_pid ())
        env.set_environment_variable (inherited_key ()) (sm'.show own)
        !+
    |: !-

:~ owns_holder (own : u64) (~holder : string) : bool = sm'.starts_with (sm'.show own ++# " ") holder

:~ lock_released (~root : string) : bool =
    ? held_by_ancestor root
    ?> !+
    |:
        := own : u64 = convert.convert (rig_os_process.process.own_pid ())
        := holder = file_system.read_text_or_empty (lock_holder_path root)
        := _ = ? owns_holder own holder ?> state_lock_cleared root |: ()
        !+

///> rust
:# a_lock_is_stale_only_when_its_holder_is_gone_or_ten_minutes_old =
    := alive = \ (pid : u64) => pid = 7u64
    testing.expect (holder_stale_by alive "" 1000u64) "a lock without a holder line is stale"
    testing.expect (holder_stale_by alive "7 1000" 2000u64 |> not) "a live holder keeps its lock"
    testing.expect (holder_stale_by alive "8 1000" 2000u64) "a dead holder's lock is stale"
    testing.expect (holder_stale_by alive "7 1000" 700000u64) "a ten-minute-old lock is stale even if its pid lives"
    testing.expect (lock_holder_text 7u64 1000u64 = "7 1000") "the holder line is the pid, then the start"
    testing.expect (owns_holder 7u64 "7 1000" && owns_holder 7u64 "70 1000" |> not) "release clears only its own holder"
    testing.expect (owns_holder 7u64 "" |> not) "an unwritten holder belongs to no one"
:= main () : i32 =
    export "rig_agile_lock_taken" lock_taken
    export "rig_agile_lock_released" lock_released
    0i32
