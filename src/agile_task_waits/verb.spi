///- --package .
:# verb static =
    :< sm'_operators
    :< waits

:< sm'_operators
:< waits

:| wait_change =
    | WaitSet :: task_wait -> wait_change
    | WaitRemoved :: task_wait -> wait_change
    | WaitCleared :: string -> wait_change

:| waits_write =
    | WaitsWritten :: i32 * string -> waits_write
    | WaitsRefused :: string -> waits_write

:= waits_schema () : string =
    "///- --no-respell\nunion task_wait =\n" ^^ "    | Waits :: string * string * string -> task_wait\n"

:~ change_item (change : wait_change) : string =
    ?= change ?|
    | WaitSet w => w.item
    | WaitRemoved w => w.item
    | WaitCleared item => item

:~ waits_changed (waits : list task_wait) (change : wait_change) : list task_wait =
    := other = \ (target : task_wait) => waits |> listm'.filter (\ (w : task_wait) => w <> target)
    ?= change ?|
    | WaitSet w => listm.append (other w) [ w ]
    | WaitRemoved w => other w
    | WaitCleared item => waits |> listm'.filter (\ (w : task_wait) => w.item <> item)

:~ ^ numbered_rows (waits : list task_wait) (seen : list string) (~text : string) : string =
    ?= waits ?|
    | [] => text
    | w :: rest =>
        := n = (seen |> listm'.filter (\ (id : string) => id = w.item) |> listm.length) + 1i32
        numbered_rows rest (w.item :: seen) (text ++# row_of_wait_numbered w n ++# "\n")

:~ waits_text (waits : list task_wait) : string = waits_schema () ++# numbered_rows waits [] ""

:~ item_waits (waits : list task_wait) (~item : string) : string =
    waits
    |> listm'.filter (\ (w : task_wait) => w.item = item)
    |> listm.map (\ (w : task_wait) => kind_word w.kind ++# ":" ++# kind_value w.kind)
    |> sm'.concat_list ";"

:~ module_added (format : agile_state_fs.project.project_format) (~package_text : string) : option string =
    ?= agile_state_fs.project.project_with_module format package_text "waits" ?|
    | agile_state_fs.project.ModuleListed => Some package_text
    | agile_state_fs.project.ModuleAdded listed => Some listed
    | agile_state_fs.project.NoModulesSection => None

:~ text_of (~path : string) : string = agile_state_fs.model.read_state path

:~ replaced (~path : string) (~text : string) : bool =
    ?= workspace_primitives.files.replace_file_checked path text ?|
    | workspace_primitives.files.Replaced => !+
    | _ => !-

:~ waits_written (~root : string) (change : wait_change) : waits_write =
    := state = sm'.replace "\\" "/" root ++# "/state"
    := agile_text = text_of (state ++# "/agile.spi")
    := path = state ++# "/waits.spi"
    := before = text_of path
    := item = change_item change
    := waits = waits_changed (waits_of_text before) change
    := own = waits |> listm'.filter (\ (w : task_wait) => w.item = item) |> listm.length
    := own_waits = item_waits waits item
    := package = agile_state_fs.project.project_path_in state
    ? agile_text = ""
    ?> WaitsRefused ("no backlog state at " ++# state)
    |? sm'.contains ("Task (\"" ++# item ++# "\"") agile_text |> not
    ?> WaitsRefused ("no task " ++# item)
    |? text_of path <> before
    ?> WaitsRefused "state/waits.spi changed since it was read; run again"
    |? replaced path (waits_text waits) |> not
    ?> WaitsRefused "state/waits.spi could not be written"
    |:
        ?= module_added (agile_state_fs.project.project_format_in state) (text_of package) ?|
        | None => WaitsRefused "the state project has no modules section to list waits in"
        | Some listed =>
            ? listed = text_of package || replaced package listed
            ?> WaitsWritten (own, own_waits)
            |: WaitsRefused "the state project was not updated"

:~ ^ author_dropped (words : list string) : list string =
    ?= words ?|
    | flag :: _ :: rest ?& flag = "--as" => author_dropped rest
    | word :: rest => word :: author_dropped rest
    | [] => []

:~ wait_run () : i32 =
    := forms = "--wait <train|item|lane|user|job|when>:<value> | --wait-remove <kind>:<value> | --wait --clear"
    := usage = "rig error: usage: agile edit <root> <ID> " ++# forms
    := change =
        ?= author_dropped (env.command_line_arguments ()) ?|
        | _ :: _ :: root :: item :: flag :: value :: [] ?& flag = "--wait" && value = "--clear" =>
            Some (root, WaitCleared item)
        | _ :: _ :: root :: item :: flag :: value :: [] ?& flag = "--wait" =>
            ?= kind_of_flag value ?|
            | Some kind => Some (root, WaitSet { item = item; kind = kind })
            | None => None
        | _ :: _ :: root :: item :: flag :: value :: [] ?& flag = "--wait-remove" =>
            ?= kind_of_flag value ?|
            | Some kind => Some (root, WaitRemoved { item = item; kind = kind })
            | None => None
        | _ => None
    ?= change ?|
    | None =>
        console.write_error_line usage
        2i32
    | Some (root, c) =>
        ?= waits_written root c ?|
        | WaitsWritten (count, listed) =>
            := head = "rig agile edit ok id=" ++# change_item c ++# " waits=" ++# sm'.show count
            console.write_line (head ++# " item_waits=" ++# listed)
            0i32
        | WaitsRefused reason =>
            console.write_error_line ("rig error: agile edit --wait: " ++# reason)
            2i32

:~ waiting_of (text : string) : array_base task_wait = waits_of_text text |> listm'.box |> listm'.to_array'

///> rust
:# a_task_has_one_wait_row_and_clear_drops_it =
    := train = { item = "S7"; kind = WaitsTrain "TRAIN40" }
    := delegate = { item = "S7"; kind = WaitsItem "DELEGATE-2" }
    := one = waits_changed [] (WaitSet train)
    := both = waits_changed one (WaitSet delegate)
    testing.expect (both = [ train; delegate ]) "a second wait on the same item keeps the first"
    testing.expect (waits_changed both (WaitSet train) = [ delegate; train ]) "the same wait twice stays one row"
    testing.expect (waits_changed both (WaitRemoved train) = [ delegate ]) "remove drops only that wait"
    testing.expect (waits_changed both (WaitCleared "S7") = []) "clear drops them all"
    := row = "inl wait_of_s7 () = Waits (\"S7\", \"train\", \"TRAIN40\")\n"
    testing.expect (waits_text one = waits_schema () ++# row) "file text"
    := second = "inl wait_of_s7_2 () = Waits (\"S7\", \"item\", \"DELEGATE-2\")\n"
    testing.expect (waits_text both = waits_schema () ++# row ++# second) "the second row gets its own binding"
    testing.expect (item_waits both "S7" = "train:TRAIN40;item:DELEGATE-2") "the receipt lists the item's waits"
    := words = agile_state_fs.project.SpiprojProject
    testing.expect (module_added words "modules:\n    claims\n" = Some "modules:\n    waits\n    claims\n") "register"
    testing.expect (module_added words "modules:\n    waits\n" = Some "modules:\n    waits\n") "already listed"
    testing.expect (module_added words "packages:\n" = None) "no modules section"
    testing.expect (module_added agile_state_fs.project.TomlProject "modules = '''\nclaims\n'''\n" = Some "modules = '''\nwaits\nclaims\n'''\n") "register in spiral.toml"

:= main () : i32 =
    export "rig_agile_waits_of" waiting_of
    export "rig_agile_wait_run" wait_run
    0i32

///> rust
:# edit_wait_takes_a_trailing_author_like_the_other_writes =
    := words = [ "agile"; "edit"; "r"; "A"; "--wait"; "train:T" ]
    testing.expect (author_dropped (listm.append words [ "--as"; "rig" ]) = words) "a trailing --as is dropped"
    testing.expect (author_dropped words = words) "nothing else changes"
