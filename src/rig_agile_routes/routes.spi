:< agile_mutation_policy.model
:< sm'_operators
:< agile_subcommand_domain.subcommand
:< workspace_primitives.outcome

:= agile_mutation_error (~message : string) : i32 = workspace_primitives.console.stderr_failure message

:= argument_count_is expected : bool = rust_std_env.model.argument_count_is expected
:= argument_byte_count index : i32 = rust_std_env.model.argument_byte_count index
:= argument_byte index offset : i32 = rust_std_env.model.argument_byte index offset
:= argument_owned index : string = rust_std_env.model.argument_owned index
:= argument_equals index expected : bool = rust_std_env.model.argument_equals index expected
:= i32_positive value : bool = $"0 < !value"
:= i32_digit value : bool = ? 48i32 <= value ?> value <= 57i32 |: !-
:= i32_digit_value value : i32 = $"!value - 48"
:= i32_pair_value a b : i32 = $"!a * 10 + !b"
:= i32_triple_value a b c : i32 = $"!a * 100 + !b * 10 + !c"
:= invalid_i32 () : i32 = $"-1"
:= all2 a b = ? a ?> b |: !-
:= all3 a b c = ? a ?> ? b ?> c |: !- |: !-
:= all4 a b c d = ? a ?> ? b ?> ? c ?> d |: !- |: !- |: !-

:= agile_full_usage_error () : i32 =
    := ~message =
        !!!!StaticStringConcat("agile supports ", agile_subcommand_domain.subcommand.agile_subcommand_usage ", ")
    agile_mutation_error message
:= received_operands () : string = sm'.show (rust_std_env.model.argument_count_after 3i32)
:= agile_shape_error (~subcommand : string) (~shape : string) : i32 =
    := head = "agile " ++# subcommand ++# " expects " ++# shape ++# ", received "
    := message = head ++# (received_operands ()) ++# " operands; see kit agile --help"
    agile_mutation_error message
:~ agile_usage_error () : i32 =
    := subcommand = argument_owned 0i32
    := shape = agile_subcommand_domain.subcommand.agile_subcommand_shape subcommand
    ? (shape = "") ?> agile_full_usage_error () |: agile_shape_error subcommand shape
:= agile_title_error () : i32 = agile_mutation_error "begin title must contain 3..7 visible words"
:= agile_slot_error (~slot : string) (~expected : string) (index : i32) : i32 =
    := message =
            "agile set: "
            ++# slot
            ++# (" must be " ++# expected ++# ", received '" ++# (argument_owned index) ++# "'")
            ++# "; usage: agile set <root> <id> <progress|-> <Planned|Active|Blocked|Paused|Done|Dropped>"
            ++# " [--expect <status>] [--as <lane>]"
    agile_mutation_error message
:= agile_progress_error () : i32 = agile_slot_error "progress" "a whole number 0..100" 3i32
:= agile_status_error () : i32 = agile_slot_error "status" "Planned, Active, Blocked, Paused, Done or Dropped" 4i32
:= agile_check (~root : string) : i32 = $"rig_agile_state::agile_check_owned(!root.as_ref())"
:= agile_lease_status (~root : string) : i32 = $"rig_agile_state::agile_lease_status_owned(!root.as_ref())"
:= agile_handoff (~root : string) : i32 = $"rig_handoff_render::handoff_render_owned(!root.as_ref())"
:= agile_record (~root : string) : i32 = $"rig_agile_state::agile_record_owned(!root.as_ref())"
:= agile_begin (~root : string) (~title : string) words : i32 =
    := _ = words
    $"rig_agile_state::agile_begin_owned(!root.as_ref(), !title.as_ref())"
:= agile_set (~root : string) (~id : string) (agile_progress progress) status : i32 =
    := code = agile_status_code status
    $"rig_agile_state::agile_set_validated_owned(!root.as_ref(), !id.as_ref(), !progress, !code)"

:= digit_value index offset : i32 =
    := value = argument_byte index offset
    ? i32_digit value ?> i32_digit_value value |: invalid_i32 ()
:~ progress_in (~text : string) (~id : string) : i32 =
    $'{ let text = &*!text; let key = format\!("Task ({q}{}{q}, {q}", &*!id, q = char::from(34u8)); \
        match text.find(&key) { None => -1i32, Some(at) => { let rest = &text[at + key.len()..]; \
            let mut escaped = false; let mut end = None; \
            for (i, ch) in rest.char_indices() { \
                if escaped { escaped = false; continue; } \
                if ch == char::from(92u8) { escaped = true; continue; } \
                if ch == char::from(34u8) { end = Some(i); break; } } \
            end.and_then(|e| rest[e + 1..].split(char::from(44u8)).map(str::trim).nth(4) \
                .and_then(|field| field.strip_suffix("u32")).and_then(|n| n.parse::<i32>().ok())).unwrap_or(-1) } } }'
    : i32

:= current_progress () : validation_result agile_progress =
    := text = agile_state_fs.model.read_state (sm'.replace "\\" "/" (argument_owned 1i32) ++# "/state/agile.spi")
    := progress = progress_in text (argument_owned 2i32)
    ? progress >= 0i32 && progress <= 100i32 ?> Valid (agile_progress progress) |: Invalid

:= validate_given_progress () : validation_result agile_progress =
    := length = argument_byte_count 3i32
    := a = digit_value 3i32 0i32
    := b = digit_value 3i32 1i32
    := c = digit_value 3i32 2i32
    ? all2 (length = 1i32) (i32_nonnegative a)
    ?> Valid (agile_progress a)
    |? all3 (length = 2i32) (i32_nonnegative a) (i32_nonnegative b)
    ?> Valid (agile_progress (i32_pair_value a b))
    |? all4 (length = 3i32) (i32_nonnegative a) (i32_nonnegative b) (i32_nonnegative c) ?>
        := value = i32_triple_value a b c
        ? value <= 100i32 ?> Valid (agile_progress value) |: Invalid
    |: Invalid
:= validate_progress () : validation_result agile_progress =
    ? argument_owned 3i32 = "-" ?> current_progress () |: validate_given_progress ()
:= validate_status () : validation_result agile_status =
    := text = argument_owned 4i32
    union_reflection.cases.union_cases_fold
        \ parsed (status : agile_status) =>
            ? (text = (union_reflection.cases.union_case_suffix "Agile" status))
            ?> Valid status
            |: parsed
        Invalid

:~ planning_field_named (~name : string) : bool =
    union_reflection.cases.union_case_where
        \ (field : agile_planning_model.model.planning_field) =>
            name = agile_planning_model.model.planning_field_name field
        \ _ => !+
        !-
:= agile_edit_route () : i32 =
    ? argument_owned 3i32 = "--parent"
    ?> agile_task_parents.verb.parent_edit_run ()
    |? argument_owned 3i32 = "--after"
    ?> agile_task_afters.verb.after_edit_run ()
    |? argument_owned 3i32 = "--asked"
    ?> agile_task_asks.verb.ask_edit_run ()
    |? argument_owned 3i32 = "--split"
    ?> agile_task_split.verb.split_run ()
    |? argument_owned 3i32 = "--wait" || argument_owned 3i32 = "--wait-remove"
    ?> agile_task_waits.verb.wait_run ()
    |? planning_field_named (argument_owned 3i32)
    ?> $"agile_planning_revision::rig_agile_planning_edit_run()"
    |: $"agile_task_revision::rig_agile_edit_run()"
:= agile_begin_route () : i32 =
    := root = argument_owned 1i32
    := title = argument_owned 2i32
    := words : i32 = $"rig_agile_lease::rig_lease_title_words()"
    ? i32_positive words ?> agile_begin root title words |: agile_title_error ()
:= agile_done_route (~root : string) (~id : string) progress : i32 =
    := sites = $'std::rc::Rc::<str>::from(agile_todo_scan::rig_agile_todo_sites(&*!root, &*!id).trim_end())' : string
    ? (sites = "")
    ?> agile_set root id progress AgileDone
    |:
        := message =
                "agile set "
                ++# id
                ++# " rejected: TODO blocks still name it; cut them or keep the item open:\n"
                ++# sites
        agile_mutation_error message
:~ ^ checks_joined (rows : array_base agile_quality_lint.lint.failure_row) (at : i32) (~text : string) : string =
    ? at >= am'.length_base rows
    ?> text
    |:
        := check = (am'.index_base at rows).check
        checks_joined rows (at + 1i32) (? text = "" ?> check |: text ++# "," ++# check)

:~ lint_warned (~root : string) (~id : string) (~status : string) : () =
    := state = sm'.replace "\\" "/" root ++# "/state"
    := read = \ (name : string) => agile_state_fs.model.read_state (state ++# "/" ++# name)
    := text = read "agile.spi" ++# "\n" ++# read "waits.spi" ++# "\n" ++# read "markers.spi"
    := checks = checks_joined (agile_quality_state.state_rows.item_failures (text, id, status)) 0i32 ""
    ? checks = ""
    ?> ()
    |:
        := head = "rig agile lint warning id=" ++# id ++# " status=" ++# status ++# " failing=" ++# checks
        := markers = " (add a note with the marker lines, e.g. 'dod:' and 'next:', or ones state/markers.spi declares"
        console.write_error_line (head ++# markers ++# "; a later train refuses the change)")
        ? sm'.contains "ProseWait" checks
        ?>
            := form = " --wait <train|item|lane|user|job|when>:<value>"
            := command = "rig agile edit " ++# root ++# " " ++# id ++# form
            := hint = "  ProseWait: a wait in prose keeps the item in agile next; record it: "
            console.write_error_line (hint ++# command)
        |: ()

:~ status_now (~root : string) (~id : string) : string =
    := text = agile_state_fs.model.read_state (sm'.replace "\\" "/" root ++# "/state/agile.spi")
    := named = \ (f : agile_quality_lint.lint.fact_row) => f.id = id
    ?= agile_quality_state.state_rows.facts_list text |> listm'.try_find_ named ?|
    | Some f => f.status
    | None => ""

:~ expect_refusal (~id : string) (~current : string) (~expected : string) : i32 =
    := head = "agile set " ++# id ++# " rejected: the status changed since it was read; it is "
    agile_mutation_error (head ++# current ++# ", --expect said " ++# expected ++# "; nothing written")

:= agile_set_route () : i32 =
    := root = argument_owned 1i32
    := id = argument_owned 2i32
    := flag = \ (name : string) =>
        ? argument_owned 5i32 = name
        ?> argument_owned 6i32
        |? argument_owned 7i32 = name
        ?> argument_owned 8i32
        |: ""
    := expected = flag "--expect"
    := author = flag "--as"
    := current = ? expected = "" ?> "" |: status_now root id
    := stale = ? expected = "" ?> agile_status_changes.changes.stale_warning root id author |: ""
    ? expected <> "" && current <> expected
    ?> expect_refusal id current expected
    |:
        ?= validate_progress (), validate_status () ?|
        | Valid progress, Valid status =>
            := code =
                ?= status ?|
                | AgileDone => agile_done_route root id progress
                | _ => agile_set root id progress status
            := _ = ? code = 0i32 ?> lint_warned root id (argument_owned 4i32) |: ()
            := _ = ? code = 0i32 && stale <> "" ?> console.write_error_line stale |: ()
            := recorded = \ () => agile_status_changes.changes.change_recorded (root, id, argument_owned 4i32, author)
            := _ = ? code = 0i32 ?> recorded () |: 0i32
            code
        | Invalid, _ => agile_progress_error ()
        | _, Invalid => agile_status_error ()

:= main () : i32 =
    export "rig_agile_usage_error" ((\ () => agile_usage_error ()) : () -> i32)
    export "rig_agile_begin_route" ((\ () => agile_begin_route ()) : () -> i32)
    export "rig_agile_set_route" ((\ () => agile_set_route ()) : () -> i32)
    export "rig_agile_edit_route" ((\ () => agile_edit_route ()) : () -> i32)
    export "rig_agile_ask_route" ((\ () => agile_task_asks.verb.ask_now_run ()) : () -> i32)
    0i32
