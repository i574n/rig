:< rig_crate_walk.walk
:< sm'_operators
:< file_system_operators
:< model

:~ ^ rows_from (rows : array_base crate_measure) (at : i32) (kept : list crate_measure) : list crate_measure =
    ? at < 0i32 ?> kept |: rows_from rows (at - 1i32) (am'.index_base at rows :: kept)

:~ rows_listed (rows : array_base crate_measure) : list crate_measure = rows_from rows (am'.length_base rows - 1i32) []

:~ ^ digits_value (text : string) (at : i32) (value : i32) : i32 =
    ? (sm'.length text : i32) <= at
    ?> value
    |:
        := c = xml.code_point_at text at
        ? 48u32 <= c && c <= 57u32
        ?> digits_value text (at + 1i32) (value * 10i32 + convert.i32 (c - 48u32))
        |: -1i32

:| gate_flag =
    | FlagEnforce
    | FlagLimit
    | FlagBackend

:== gate_flags = { enforce : bool; limit : string; backend : string }

:~ flag_word (flag : gate_flag) : string = "--" ++# union_reflection.cases.union_case_kebab "Flag" flag

:~ ^ gate_flags_read (words : list string) (flags : gate_flags) : gate_flags =
    ?= words ?|
    | word :: rest ?& word = flag_word FlagEnforce => gate_flags_read rest { flags ?| enforce = !+ }
    | word :: value :: rest ?& word = flag_word FlagLimit => gate_flags_read rest { flags ?| limit = value }
    | word :: value :: rest ?& word = flag_word FlagBackend => gate_flags_read rest { flags ?| backend = value }
    | _ :: rest => gate_flags_read rest flags
    | [] => flags

:~ ^ lines_printed (limit : i32) (measures : list crate_measure) : () =
    ?= measures ?|
    | [] => ()
    | (m :: rest) =>
        console.write_line (measure_line limit m)
        lines_printed limit rest

:~ outcome_text (backend : target_backend) (outcome : gate_outcome) (~summary : string) : i32 * string =
    := refused = "rig crate gate refused: "
    ?= outcome ?|
    | GatePassed => 0i32, "rig crate gate ok" ++# summary
    | GateFailedOver n => 1i32, refused ++# sm'.format n ++# " crate(s) over the limit;" ++# summary
    | GateFailedMissing n =>
        := why = " crate(s) have no generated output, so generation did not run or failed;"
        1i32, refused ++# sm'.format n ++# why ++# summary
    | GateFailedVacuous =>
        := nothing =
            ?= backend ?|
            | RustTarget => "no crate with [package.metadata.spiral] under the root"
            | _ => "no " ++# backend_extension backend ++# " file under the root"
        1i32, refused ++# nothing ++# ", so nothing was measured;" ++# summary

:~ target_limits_text () : string =
    := rig_home = env.get_environment_variable "RIG_CONFIG_HOME"
    := home = ? rig_home <> "" ?> rig_home |: env.get_environment_variable "KIT_CONFIG_HOME"
    := app_data = env.get_environment_variable "APPDATA"
    := dir =
        ? home <> ""
        ?> home
        |? app_data <> ""
        ?> app_data ++# "/kit"
        |: env.get_environment_variable "HOME" ++# "/.config/kit"
    file_system.read_text_or_empty (dir ++# "/target_limits.spi")

:~ gate_checked (~root : string) (flags : gate_flags) (backend : target_backend) : i32 =
    := given = flags.limit
    := limit = ? given = "" ?> target_limit_of (target_limits_text ()) backend |: digits_value given 0i32 0i32
    ? root = "" || file_system.directory_exists root |> not ?>
        console.write_line (
            "rig error: crate usage: crate gate <root> [--enforce] [--limit n] [--backend rust|gleam|zig] "
            ^^ "(rust: generated output of every Cargo.toml with [package.metadata.spiral] under root; "
            ^^ "gleam and zig: every .gleam or .zig file under root)"
        )
        2i32
    |? limit <= 0i32 ?>
        console.write_line ("rig error: crate gate: --limit expects a positive whole number, got " ++# given)
        2i32
    |:
        := measures =
            ?= backend ?|
            | RustTarget => rig_crate_walk.walk.crate_measures root |> rows_listed
            | _ => rig_crate_walk.walk.output_measures (root, backend_extension backend) |> rows_listed
        lines_printed limit measures
        := over = over_count limit measures
        := summary =
            " crates="
            ++# sm'.format (listm.length measures : i32)
            ++# " over="
            ++# sm'.format over
            ++# " limit="
            ++# sm'.format limit
            ++# " backend="
            ++# backend_word backend
            ++# " root="
            ++# root
        := code, text = outcome_text backend (gate_outcome_of flags.enforce limit measures) summary
        console.write_line text
        code

:~ gate_started (~root : string) (flags : gate_flags) : i32 =
    ?= backend_named (? flags.backend = "" ?> "rust" |: flags.backend) ?|
    | Some backend => gate_checked root flags backend
    | None =>
        console.write_line ("rig error: crate gate: --backend expects rust, gleam or zig, got " ++# flags.backend)
        2i32

:~ gate_run () : i32 =
    := start = { enforce = !-; limit = ""; backend = "" }
    ?= env.command_line_arguments () ?|
    | _ :: _ :: root :: words => gate_started root (gate_flags_read words start)
    | _ => gate_started "" start

:= main () : i32 =
    export "rig_crate_gate_run" ((\ () => gate_run ()) : () -> i32)
    0i32
