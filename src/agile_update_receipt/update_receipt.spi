///- --package .
:# update_receipt static =
    :< workspace_primitives.numbers
    :< sm'_operators
    :< workspace_primitives.clock
    :< workspace_primitives.files

:< workspace_primitives.numbers
:< sm'_operators
:< workspace_primitives.clock
:< workspace_primitives.files

:~ agile_set_receipt_text
    (~id : string) (progress : i32) (~status : string) (before : u64) (after : u64) (started : u64)
    : string
    =
    := head = "rig agile set ok id=" ++# id ++# " progress=" ++# (i32_text progress) ++# " status="
    := attested = head ++# status ++# " validation=runtime-attested compiler=not-required"
    attested ++# (measured_sizes before after (ms_since started))

:~ agile_clock_ms () : u64 = unix_ms ()

///> rust
:# the_set_receipt_carries_the_fields_kit_agile_set_promises =
    := text = agile_set_receipt_text "KIT-A" 50i32 "Active" 10u64 12u64 (agile_clock_ms ())
    := head = "rig agile set ok id=KIT-A progress=50 status=Active validation=runtime-attested compiler=not-required"
    := sizes = " bytes_before=10 bytes_after=12 elapsed_ms="
    testing.expect (sm'.starts_with (head ++# sizes) text) "receipt fields in order"
    testing.expect (agile_clock_ms () > 1700000000000u64) "the clock reads real epoch milliseconds"
:= main () : i32 =
    export "rig_agile_clock_ms" ((\ () => agile_clock_ms ()) : () -> u64)
    export
        "rig_agile_set_receipt_text"
        (
            \ (id, progress, status, before, after, started) =>
                agile_set_receipt_text id progress status before after started
            : string * i32 * string * u64 * u64 * u64 -> string
        )
    := _ = agile_set_receipt_text "ID" 50i32 "Active" 10u64 12u64 (agile_clock_ms ())
    0i32
