///- --package .
:# task_notes static =
    :< rust_std_fs.model
    :< agile_state_fs.model
    :< sm'_operators
    :< agile_task_text.model
    :< agile_note_model.model
    :< workspace_primitives.outcome
    :< workspace_primitives.numbers
    :< workspace_primitives.bytes
    :< workspace_primitives.clock
    :< workspace_primitives.console
    :< workspace_primitives.files

:< rust_std_fs.model

:< agile_state_fs.model
:< sm'_operators
:< agile_task_text.model
:< agile_note_model.model
:< workspace_primitives.outcome
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< workspace_primitives.clock
:< workspace_primitives.console
:< workspace_primitives.files

:= argument_owned index : string = rust_std_env.model.argument_owned index

:= default_author () : string = "user"

:~ note_text_of (~raw : string) : string = sm'.trim (? sm'.trim raw = "-" ?> console.read_to_end () |: raw)

:~ file_text_of (~path : string) : string = ? file_system.file_exists path ?> file_system.read_all_text path |: ""

:| note_author_choice =
    | AuthorDefault
    | AuthorNamed : string
    | AuthorUnnamedAgent
    | AuthorMalformed

:= unnamed_choice () : note_author_choice =
    := author = sm'.trim (rust_std_env.model.variable_twin "AUTHOR")
    ? author <> ""
    ?> AuthorNamed author
    |? rust_std_env.model.agent_session ()
    ?> AuthorUnnamedAgent
    |: AuthorDefault

:== note_request =
    {
        body : string
        text_file : string
        author : note_author_choice
    }

:= named_author (~named : string) : note_author_choice =
    ? sm'.trim named = "" ?> AuthorMalformed |: AuthorNamed (sm'.trim named)

:~ note_request_from (words : list string) : note_request =
    ?= words ?|
    | _ :: _ :: _ :: _ :: f :: path :: [] ?& f = "--text-file" =>
        { body = ""; text_file = path; author = unnamed_choice () }
    | _ :: _ :: _ :: _ :: f :: path :: a :: name :: [] ?& f = "--text-file" && a = "--as" =>
        { body = ""; text_file = path; author = named_author name }
    | _ :: _ :: _ :: _ :: a :: name :: f :: path :: [] ?& f = "--text-file" && a = "--as" =>
        { body = ""; text_file = path; author = named_author name }
    | _ :: _ :: _ :: _ :: text :: [] => { body = note_text_of text; text_file = ""; author = unnamed_choice () }
    | _ :: _ :: _ :: _ :: text :: flag :: name :: [] ?& flag = "--as" =>
        { body = note_text_of text; text_file = ""; author = named_author name }
    | _ :: _ :: _ :: _ :: flag :: name :: text :: [] ?& flag = "--as" =>
        { body = note_text_of text; text_file = ""; author = named_author name }
    | _ :: _ :: _ :: _ :: text :: _ => { body = note_text_of text; text_file = ""; author = AuthorMalformed }
    | _ => { body = ""; text_file = ""; author = AuthorMalformed }

:~ note_request_of () : note_request = note_request_from (env.command_line_arguments ())

:= note_failure (~reason : string) (~id : string) : i32 =
    stderr_failure ("agile note " ++# id ++# " rejected: " ++# reason)

:= note_success (~id : string) (seq : i32) (note : task_note) (before : u64) (after : u64) (elapsed : u64) : i32 =
    := head = "rig agile note ok id=" ++# id ++# " note=" ++# (i32_text seq) ++# " at="
    := middle =
        note.at ++# " author=" ++# (spi_quoted note.author) ++# " text_bytes=" ++# (i32_text (byte_len note.text))
    stdout_line (head ++# middle ++# (measured_sizes before after elapsed))

:~ note_added (~root : string) (~id : string) (~author : string) (~body : string) : i32 =
    := started = unix_ms ()
    := state = backlog_state_path root
    ?= probe (unchecked state) ?|
    | FileMissing _ => note_failure "state/agile.spi is missing" id
    | FileReadable file =>
        := raw = loaded_string (read_text file)
        := original = records_text raw
        ? task_declared original id ?>
            := schema_ready = note_schema_ensured original
            := state_dir = root ++# "/state"
            := segments = $'agile_note_listing::rig_agile_state_segments(&*!state_dir)' : string
            := seq = note_count (schema_ready ++# "\n" ++# segments) id + 1i32
            := note = { at = utc_stamp started; author = author; text = body }
            := row = note_row id seq note
            := stamp = note.at
            := problem, after =
                $'agile_note_segments::rig_agile_note_persisted(&*!state_dir, &*!state, &*!raw, &*!schema_ready, \
                    &*!id, &*!row, &*!stamp)' : string * u64
            ? problem = "" ?> note_success id seq note (text_bytes original) after (ms_since started)
            |: note_failure problem id
        |: note_failure "no task with this id" id

:~ note_entry () : i32 =
    := id = argument_owned 2i32
    := request = note_request_of ()
    := from_file = request.text_file <> ""
    := body = ? from_file ?> note_text_of (file_text_of request.text_file) |: request.body
    ? from_file && (file_system.file_exists request.text_file |> not)
    ?> note_failure ("--text-file " ++# request.text_file ++# " does not exist") id
    |? (body = "")
    ?> note_failure "the note text is empty" id
    |:
        ?= request.author ?|
        | AuthorDefault => note_added (argument_owned 1i32) id (default_author ()) body
        | AuthorNamed author => note_added (argument_owned 1i32) id author body
        | AuthorUnnamedAgent =>
            note_failure
                (
                    "an agent session must name the note's author: agile note <root> <id> <text> --as <author> (or "
                    ^^ "set KIT_AUTHOR)"
                )
                id
        | AuthorMalformed => note_failure "usage: agile note <root> <id> <text> [--as <author>]" id

:| groomed =
    | GroomedText : string
    | GroomedRefused : string

:= groomed_from (code, detail) : groomed = ? code = 0i32 ?> GroomedText detail |: GroomedRefused detail

:~ planned (step : groomed) (~id : string) (~field_name : string) (~value : string) : groomed =
    ?= step ?|
    | GroomedRefused _ => step
    | GroomedText text =>
        ? value = ""
        ?> step
        |:
            ?=
                groomed_from (
                    $'agile_planning_values::rig_agile_planning_value_token(&*!field_name, &*!value)' : i32 * string
                )
            ?|
            | GroomedRefused reason => GroomedRefused reason
            | GroomedText token =>
                groomed_from (
                    $'agile_planning_rewrite::rig_agile_planning_rewrite(&*!text, &*!id, &*!field_name, &*!token)'
                    : i32 * string
                )

:~ groomed_text
    (~text : string) (~id : string) (~estimate : string) (~load : string) (~assignee : string) (~body : string)
    (~author : string)
    : i32 * string
    =
    ?= planned (planned (planned (GroomedText text) id "estimate" estimate) id "load" load) id "assignee" assignee ?|
    | GroomedRefused reason => 1i32, reason
    | GroomedText planned_text =>
        ? body = ""
        ?> 0i32, planned_text
        |:
            0i32,
            notes_appended
                (note_schema_ensured planned_text)
                id
                (note_row id 1i32 { at = utc_stamp (unix_ms ()); author = author; text = body })

///> rust
:# note_arguments_read_from_the_word_list =
    := named = note_request_from [ "agile"; "note"; "root"; "ID"; "text"; "--as"; "kit" ]
    testing.expect (named.body = "text" && named.author = AuthorNamed "kit") "text then --as author"
    := first = note_request_from [ "agile"; "note"; "root"; "ID"; "--as"; "kit"; "text" ]
    testing.expect (first.body = "text" && first.author = AuthorNamed "kit") "--as author then text"
    := blank = note_request_from [ "agile"; "note"; "root"; "ID"; "text"; "--as"; " " ]
    testing.expect (blank.author = AuthorMalformed) "a blank author is malformed"
    := filed = note_request_from [ "agile"; "note"; "root"; "ID"; "--text-file"; "n.txt"; "--as"; "kit" ]
    testing.expect (filed.text_file = "n.txt" && filed.author = AuthorNamed "kit") "--text-file then --as"
    := filed_first = note_request_from [ "agile"; "note"; "root"; "ID"; "--as"; "kit"; "--text-file"; "n.txt" ]
    testing.expect (filed_first.text_file = "n.txt" && filed_first.body = "") "--as then --text-file"
    testing.expect (named.text_file = "") "inline text names no file"
    := extra = note_request_from [ "agile"; "note"; "root"; "ID"; "text"; "--by"; "kit" ]
    testing.expect (extra.author = AuthorMalformed && extra.body = "text") "an unknown flag is malformed"
:= main () : i32 =
    export "rig_agile_note_run" ((\ () => note_entry ()) : () -> i32)
    export
        "rig_agile_groomed"
        (
            \ (text, id, estimate, load, assignee, body, author) =>
                groomed_text text id estimate load assignee body author
            : string * string * string * string * string * string * string -> i32 * string
        )
    export "rig_utc_stamp" ((\ stamped => utc_stamp stamped) : u64 -> string)
    := _ = note_entry ()
    0i32
