///- --package .
:# model static =
    :< sm'_operators
    :< rig_units_model.shape

:< sm'_operators
:< rig_units_model.shape

:~ host_call_deps (units : list unit) : i32 =
    := per = \ (count : i32) (u : unit) =>
        := hosts = u.deps |> listm'.filter (\ (d : string) => is_unit units d && (listm'.contains d u.links |> not))
        count + (listm.length hosts : i32)
    units |> listm.fold per 0i32

///> rust
:# a_dependency_on_a_unit_without_a_link_is_a_host_call_dep =
    := base =
        { name = "tu_model"; kind = Model; packages = []; links = []; deps = []; entry = ""; modules = []; crate = !+ }
    := linked = { base ?| name = "tu_feature"; kind = Feature; deps = [ "tu_model" ]; links = [ "tu_model" ] }
    testing.expect (host_call_deps [ base; linked ] = 0i32) "a linked dep is not counted"
    testing.expect (host_call_deps [ base; { linked ?| links = [] } ] = 1i32) "a host call dep is counted"
    testing.expect (host_call_deps [ base; { linked ?| deps = [ "elsewhere" ]; links = [] } ] = 0i32) "a non-unit dep"
