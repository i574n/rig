:< sm'_operators
:< rig_machine_watch_model.model

:= line_count (~text : string) : i32 = $'(&*!text).lines().filter(|line| \!line.is_empty()).count() as i32' : i32
inl line_at (~text : string) (index : i32) : string = $'std::rc::Rc::<str>::from((&*!text).lines().filter(|line| \
    \!line.is_empty()).nth(!index as usize).unwrap_or(""))' : string
:= appended (~text : string) (~line : string) : string = ? text = "" ?> line |: text ++# "\n" ++# line
:= job_state_word (~id : string) : string = $'rig_job_control::rig_job_state_word(&*!id)' : string
inl tab_field (~row : string) (index : i32) : string = $'std::rc::Rc::<str>::from((&*!row).split(char::from(9u8)).nth(\
    !index as usize).unwrap_or(""))' : string
inl label_job (~label : string) : string = $'std::rc::Rc::<str>::from((&*!label).split("(kit job \
    ").nth(1).and_then(|rest| rest.split(char::from(41u8)).next()).unwrap_or(""))' : string

:~ ^ windows_watched (~windows : string) (index : i32) (~report : string) : string =
    ? index >= line_count windows
    ?> report
    |:
        := row = line_at windows index
        := job = label_job (tab_field row 3i32)
        := state = ? job = "" ?> "" |: job_state_word job
        := line =
            "  " ++# tab_field row 0i32 ++# "  " ++# tab_field row 1i32 ++# "  " ++# tab_field row 2i32 ++# "  "
            ++# tab_field row 3i32 ++# window_text (window_health_of (tab_field row 2i32 = "held") state)
        windows_watched windows (index + 1i32) (appended report line)

:= main () : i32 =
    export "rig_machine_windows_lines" ((\ windows => windows_watched windows 0i32 "") : string -> string)
    0i32
