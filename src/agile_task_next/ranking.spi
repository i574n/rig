///> rust
:# priorities_weigh_four_times_per_step_and_estimates_fall_back_to_difficulty =
    testing.expect (priority_weight 0i32 = 1024i32) "P0"
    testing.expect (priority_weight 2i32 = 64i32) "P2"
    testing.expect (priority_weight 5i32 = 1i32) "P5"
    testing.expect (level_of "D6" = 6i32) "difficulty token"
    testing.expect (task_minutes (task_at "A" 0i32 6i32 "Active" "" "" 0i32) = 1200i32) "difficulty fallback"
    testing.expect (task_minutes (task_at "A" 0i32 6i32 "Active" "" "" 45i32) = 45i32) "estimate wins"

///> rust
:# main_ranks_ready_open_items_by_weight_over_duration =
    := tasks = sample_backlog ()
    testing.expect
        (ranked_ids (ranking MainAgent tasks) = "GATE SMALL-P2 KIT-SIDE BIG-P0")
        (ranked_ids (ranking MainAgent tasks))
    testing.expect (deps_settled tasks "GATE" 0i32 = !-) "an open dependency blocks"
    testing.expect (deps_settled tasks "SHIPPED, MISSING" 0i32) "done and unknown dependencies do not block"
    testing.expect (unblocked_weight tasks "GATE" 0i32 = 256i32) "GATE unblocks a P1"

///> rust
:# an_epic_shares_its_weight_across_the_open_items_it_waits_on =
    := tasks =
        TaskThen (task_at "EPIC" 1i32 7i32 "Planned" "A,B,C,D,DONE" "" 0i32,
            TaskThen (task_at "A" 4i32 2i32 "Planned" "" "" 0i32, TaskThen (task_at "B" 1i32 2i32 "Active" "" "" 0i32,
            TaskThen (task_at "C" 1i32 2i32 "Planned" "" "" 0i32, TaskThen (task_at "D" 1i32 2i32 "Planned" "" "" 0i32,
            TaskThen (task_at "DONE" 1i32 1i32 "Done" "" "" 0i32, NoTasks))))))
    testing.expect (open_deps tasks "A,B,C,D,DONE" 0i32 0i32 = 4i32) "four open, one done"
    testing.expect (unblocked_weight tasks "A" 0i32 = 64i32) "a P1 epic waiting on four open items gives each a quarter"

///> rust
:# subagents_take_the_longest_items_first =
    := elsewhere = \ (task : backlog_task) => sm'.starts_with "KIT-" task.id = !-
    := subagent_ids = ranked_ids (ranking_where Subagent elsewhere (sample_backlog ()))
    testing.expect (subagent_ids = "BIG-P0 GATE SMALL-P2") subagent_ids

///> rust
:# subagents_take_leaf_work_and_never_an_epic =
    := epic = task_at "EPIC-BIG" 0i32 8i32 "Active" "" "" 9600i32
    := tasks = TaskThen ({ epic ?| kind = "Epic" }, sample_backlog ())
    := elsewhere = \ (task : backlog_task) => sm'.starts_with "KIT-" task.id = !-
    testing.expect
        (ranked_ids (ranking_where Subagent elsewhere tasks) = "BIG-P0 GATE SMALL-P2")
        (ranked_ids (ranking_where Subagent elsewhere tasks))
    testing.expect (role_takes MainAgent { epic ?| kind = "Epic" }) "the main agent still sees epics"
    testing.expect (role_takes Subagent epic) "a story is leaf work"

///> rust
:# teams_filter_the_ranking_and_progress_shrinks_the_fallback_estimate =
    := tasks = sample_backlog ()
    testing.expect
        (
            ranked_ids (ranking_where MainAgent (\ task => sm'.starts_with "KIT-" task.id) tasks)
            = "KIT-SIDE"
        )
        "a predicate narrows the ranking"
    testing.expect
        (
            ranked_ids (ranking_where MainAgent (\ task => sm'.starts_with "SMALL" task.id) tasks)
            = "SMALL-P2"
        )
        "prefix predicate"

    := half = task_at "HALF" 1i32 6i32 "Active" "" "" 0i32
    := nearly = task_at "NEARLY" 1i32 1i32 "Active" "" "" 0i32
    := set = task_at "SET" 1i32 6i32 "Active" "" "" 45i32
    testing.expect (task_minutes { half ?| progress = 50i32 } = 600i32) "half done halves the difficulty fallback"
    testing.expect (task_minutes { nearly ?| progress = 99i32 } = 15i32) "never below 15 minutes"
    testing.expect (task_minutes { set ?| progress = 90i32 } = 45i32) "an explicit estimate is the remaining time"

///> rust
:# a_ranking_change_keeps_last_weeks_closes_near_the_top_and_lifts_neglected_user_asks =
    := rows = week_rows ()
    testing.expect (row_count rows = 649i32) "the 11-06 replay holds 649 scored items"
    testing.expect
        (closed_in_top_fifth WeightOverMinutes rows = 107i32)
        "weight over minutes puts 107 of last week's closes in the top fifth"
    testing.expect (neglected_median WeightOverMinutes rows = 64i32) "and buries neglected user asks at percentile 64"
    testing.expect
        (closed_in_top_fifth AgedAskWeighted rows * 100i32 >= closed_in_top_fifth WeightOverMinutes rows * 80i32)
        "aging and the user-ask weight keep at least 80 pct of those closes in the top fifth"
    testing.expect
        (neglected_median AgedAskWeighted rows < neglected_median WeightOverMinutes rows)
        "and lift neglected user asks"

///> rust
:# aging_lifts_idle_items_up_to_three_times_and_a_user_ask_doubles =
    testing.expect (aged_key 7000i32 0i32 !- = 7000i32) "a fresh item keeps its weight"
    testing.expect (aged_key 7000i32 7i32 !- = 14000i32) "a week idle doubles it"
    testing.expect (aged_key 7000i32 30i32 !- = 21000i32) "idleness counts at most 14 days"
    testing.expect (aged_key 7000i32 0i32 !+ = 14000i32) "a user ask doubles it"
    testing.expect (aged_key 2000000000i32 14i32 !+ = 2147483647i32) "the key saturates instead of wrapping"
    := idle = task_at "A" 1i32 2i32 "Planned" "" "" 0i32
    testing.expect (role_key Subagent 55i32 { idle ?| idle_days = 9i32 } = 55i32) "subagents rank by duration, unaged"
