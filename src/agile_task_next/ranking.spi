///- --package . --timeout 900000
:# ranking static =
    :< rust_std_string.model
    :< workspace_primitives.bytes

:< workspace_primitives.bytes

:| rank_role =
    | MainAgent
    | Subagent

:== backlog_task =
    {
        id : string
        title : string
        kind : string
        priority : i32
        difficulty : i32
        status : string
        deps : string
        tags : string
        estimate : i32
        progress : i32
        idle_days : i32
        asked : bool
        parent : string
    }

:| ^ task_list =
    | NoTasks
    | TaskThen : backlog_task * task_list

:== ranked_task =
    {
        id : string
        title : string
        priority : i32
        difficulty : i32
        minutes : i32
        estimated : bool
        unblocks : i32
        key : i32
        parent : string
    }

:| ^ ranked_list =
    | NoRanked
    | RankedThen : ranked_task * ranked_list

:= rank_role_word = \|
    | MainAgent => "main"
    | Subagent => "subagent"

:= level_of (~token : string) : i32 =
    $'(!token).get(1..).and_then(|digits| digits.parse::<i32>().ok()).unwrap_or(9)' : i32

:= priority_weight (priority : i32) : i32 = $'1i32 << (2 * (5 - (!priority).clamp(0, 5)))' : i32

:= fallback_minutes (difficulty : i32) : i32 =
    ?= difficulty ?|
    | 0i32 => 15i32
    | 1i32 => 30i32
    | 2i32 => 60i32
    | 3i32 => 180i32
    | 4i32 => 300i32
    | 5i32 => 600i32
    | 6i32 => 1200i32
    | 7i32 => 2400i32
    | _ => 3600i32

:= remaining_share (minutes : i32) (progress : i32) : i32 = $'((!minutes as i64) * (100 - (!progress).clamp(0, \
    100)) as i64 / 100).max(15) as i32' : i32

:= task_minutes (task : backlog_task) : i32 =
    ? 0i32 < task.estimate ?> task.estimate |: remaining_share (fallback_minutes task.difficulty) task.progress

:~ task_open (task : backlog_task) : bool =
    union_reflection.cases.union_case_where
        \ (status : agile_mutation_policy.model.agile_status) =>
            task.status = agile_mutation_policy.model.agile_case_text status
        agile_mutation_policy.model.agile_status_open
        !-

:= listed_in (~items : string) (~item : string) : bool =
    rust_std_string.model.pipe_member
        (sm'.replace "," "|" (sm'.replace ", " "|" items))
        item

:= query_passes (~query : string) (~id : string) (~title : string) (~tags : string) (~status : string) : bool =
    ? query = ""
    ?> !+
    |: $'agile_task_query::rig_query_passes(&*!query, &*!id, &*!title, &*!tags, &*!status, true)' : bool

:= task_passes (query : string) (task : backlog_task) : bool =
    query_passes query task.id task.title task.tags task.status

:~ ^ status_of (tasks : task_list) (~id : string) : string =
    ?= tasks ?|
    | NoTasks => ""
    | TaskThen (task, rest) => ? task.id = id ?> task.status |: status_of rest id

:~ ^ deps_settled (tasks : task_list) (~deps : string) (offset : i32) : bool =
    ? byte_len deps <= offset
    ?> !+
    |:
        := comma = byte_find_from deps "," offset
        := stop = ? comma < 0i32 ?> byte_len deps |: comma
        := status = status_of tasks (rust_std_string.model.trim (byte_slice deps offset stop))
        ? status = "" || status = "Done" ?> deps_settled tasks deps (stop + 1i32) |: !-

:~ ^ open_deps (tasks : task_list) (~deps : string) (offset : i32) (count : i32) : i32 =
    ? byte_len deps <= offset
    ?> count
    |:
        := comma = byte_find_from deps "," offset
        := stop = ? comma < 0i32 ?> byte_len deps |: comma
        := status = status_of tasks (rust_std_string.model.trim (byte_slice deps offset stop))
        open_deps tasks deps (stop + 1i32) (? status = "" || status = "Done" ?> count |: count + 1i32)

:~ ^ unblocked_weight (tasks : task_list) (~id : string) (sum : i32) : i32 =
    ?= tasks ?|
    | NoTasks => sum
    | TaskThen (task, rest) =>
        := gained =
            ? task_open task && listed_in task.deps id ?>
                := waiting = open_deps tasks task.deps 0i32 0i32
                priority_weight task.priority / (? waiting < 1i32 ?> 1i32 |: waiting)
            |: 0i32
        unblocked_weight rest id (sum + gained)

:= rank_key (role : rank_role) (weight : i32) (minutes : i32) (priority : i32) : i32 =
    ?= role ?|
    | MainAgent => $'((!weight as i64) * 6000 / (!minutes).max(1) as i64).min(i32::MAX as i64) as i32' : i32
    | Subagent => minutes * 8i32 + 5i32 - priority

:| rank_formula =
    | WeightOverMinutes
    | AgedAskWeighted

:= aged_key (base : i32) (idle_days : i32) (asked : bool) : i32 =
    := idle = ? idle_days < 14i32 ?> idle_days |: 14i32
    := factor = (7i32 + idle) * (? asked ?> 2i32 |: 1i32)
    ? base > 2147483647i32 / factor ?> 2147483647i32 |: base * factor / 7i32

:== replay_row =
    {
        priority : i32
        minutes : i32
        unblocks : i32
        idle_days : i32
        asked : bool
        closed : bool
    }

:= replay_at
    (priority : i32) (minutes : i32) (unblocks : i32) (idle_days : i32) (asked : bool) (closed : bool)
    : replay_row
    =
    {
        priority = priority
        minutes = minutes
        unblocks = unblocks
        idle_days = idle_days
        asked = asked
        closed = closed
    }

:= replay_key (formula : rank_formula) (row : replay_row) : i32 =
    := base = rank_key MainAgent (priority_weight row.priority + row.unblocks) row.minutes row.priority
    ?= formula ?|
    | WeightOverMinutes => base
    | AgedAskWeighted => aged_key base row.idle_days row.asked

:= role_key (role : rank_role) (base : i32) (task : backlog_task) : i32 =
    ?= role ?|
    | MainAgent => aged_key base task.idle_days task.asked
    | Subagent => base

:~ ranked_of (role : rank_role) (tasks : task_list) (task : backlog_task) : ranked_task =
    := minutes = task_minutes task
    := unblocks = unblocked_weight tasks task.id 0i32
    {
        id = task.id
        title = task.title
        priority = task.priority
        difficulty = task.difficulty
        minutes = minutes
        estimated = 0i32 < task.estimate
        unblocks = unblocks
        key = role_key role (rank_key role (priority_weight task.priority + unblocks) minutes task.priority) task
        parent = task.parent
    }

:= role_takes (role : rank_role) (task : backlog_task) : bool =
    ?= role ?|
    | Subagent => task.kind <> "Epic"
    | MainAgent => !+

:= candidate (role : rank_role) (passes : backlog_task -> bool) (tasks : task_list) (task : backlog_task) : bool =
    task_open task && role_takes role task && not (listed_in task.tags "user-batch")
    && deps_settled tasks task.deps 0i32 && passes task

:~ ^ inserted (item : ranked_task) (list : ranked_list) : ranked_list =
    ?= list ?|
    | NoRanked => RankedThen (item, NoRanked)
    | RankedThen (head, rest) =>
        ? head.key < item.key ?> RankedThen (item, list) |: RankedThen (head, inserted item rest)

:~ ^ ranked_from
    (role : rank_role) (passes : backlog_task -> bool) (tasks : task_list) (remaining : task_list) (list : ranked_list)
    : ranked_list
    =
    ?= remaining ?|
    | NoTasks => list
    | TaskThen (task, rest) =>
        ? candidate role passes tasks task
        ?> ranked_from role passes tasks rest (inserted (ranked_of role tasks task) list)
        |: ranked_from role passes tasks rest list

:= ranking_where (role : rank_role) (passes : backlog_task -> bool) (tasks : task_list) : ranked_list =
    ranked_from role passes tasks tasks NoRanked

:= ranking (role : rank_role) (tasks : task_list) : ranked_list = ranking_where role (\ _ => !+) tasks

:= ranking_filtered (role : rank_role) (filters : string) (tasks : task_list) : ranked_list =
    ranking_where role (\ task => task_passes filters task) tasks

:~ ^ ranked_ids (list : ranked_list) : string =
    ?= list ?|
    | NoRanked => ""
    | RankedThen (head, NoRanked) => head.id
    | RankedThen (head, rest) => rust_std_string.model.concat5 head.id " " (ranked_ids rest) "" ""


:= task_at
    (~id : string) (priority : i32) (difficulty : i32) (~status : string) (~deps : string) (~tags : string)
    (estimate : i32)
    : backlog_task
    =
    {
        id = id
        title = id
        kind = "Story"
        priority = priority
        difficulty = difficulty
        status = status
        deps = deps
        tags = tags
        estimate = estimate
        progress = 0i32
        idle_days = 0i32
        asked = !-
        parent = ""
    }

:= sample_backlog () : task_list =
    TaskThen (task_at "BIG-P0" 0i32 8i32 "Active" "" "" 0i32,
        TaskThen (task_at "SMALL-P2" 2i32 2i32 "Planned" "" "" 0i32,
            TaskThen (task_at "WAITS" 1i32 2i32 "Planned" "GATE" "" 0i32,
                TaskThen (task_at "GATE" 3i32 3i32 "Active" "" "" 0i32,
                    TaskThen (task_at "KIT-SIDE" 1i32 4i32 "Planned" "" "kit,agile" 0i32,
                        TaskThen (task_at "SHIPPED" 0i32 1i32 "Done" "" "" 0i32,
                            TaskThen (task_at "PARKED" 0i32 1i32 "Paused" "" "" 0i32, NoTasks)))))))

:~ keys_of (formula : rank_formula) (rows : list replay_row) : list i32 = listm.map (replay_key formula) rows

:~ ahead_of (keys : list i32) (key : i32) : i32 =
    listm.fold (\ count (other : i32) => ? other > key ?> count + 1i32 |: count) 0i32 keys

:~ row_count (rows : list replay_row) : i32 = listm.fold (\ count (_ : replay_row) => count + 1i32) 0i32 rows

:~ closed_in_top_fifth (formula : rank_formula) (rows : list replay_row) : i32 =
    := keys = keys_of formula rows
    := fifth = row_count rows / 5i32
    listm.fold
        (\ count (row : replay_row) =>
            ? row.closed && ahead_of keys (replay_key formula row) < fifth ?> count + 1i32 |: count)
        0i32
        rows

:= neglected_ask (row : replay_row) : bool =
    row.asked && not row.closed && row.priority <= 1i32 && row.idle_days >= 3i32

:~ neglected_shares (formula : rank_formula) (rows : list replay_row) : list i32 =
    := keys = keys_of formula rows
    := total = row_count rows
    listm.fold
        (\ (shares : list i32) (row : replay_row) =>
            ? neglected_ask row ?> (ahead_of keys (replay_key formula row) * 100i32 / total) :: shares |: shares)
        []
        rows

:~ at_or_below (shares : list i32) (share : i32) : i32 =
    listm.fold (\ count (other : i32) => ? other <= share ?> count + 1i32 |: count) 0i32 shares

:~ neglected_median (formula : rank_formula) (rows : list replay_row) : i32 =
    := shares = neglected_shares formula rows
    := needed = (listm.fold (\ count (_ : i32) => count + 1i32) 0i32 shares + 1i32) / 2i32
    listm.fold
        (\ best (share : i32) => ? at_or_below shares share >= needed && share < best ?> share |: best)
        100i32
        shares


