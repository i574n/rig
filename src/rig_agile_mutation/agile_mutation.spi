:< agile_mutation_policy.model
:< sm'_operators
:< agile_subcommand_domain.subcommand
:< workspace_primitives.outcome

:= agile_mutation_error (~message : string) : i32 = workspace_primitives.console.stderr_failure message

:! agile_idle = ()
:! agile_arguments_ready = ()
:! agile_validated = ()
:! agile_locked = ()
:! agile_committed = ()

:| agile_op from to =
    | CollectAgileArguments :: agile_op agile_idle agile_arguments_ready
    | ValidateAgileProtocol :: agile_op agile_arguments_ready agile_validated
    | LockAgileState :: agile_op agile_validated agile_locked
    | CommitAgileMutation :: agile_op agile_locked agile_committed
:| ^ agile_plan from to =
    | AgileStep :: \* from to. agile_op from to -> agile_plan from to
    | AgileThen :: \* from to. (\? middle. agile_plan from middle * agile_plan middle to) -> agile_plan from to

:= typed_agile_plan () : agile_plan agile_idle agile_committed =
    AgileThen (
        \? (
            AgileStep CollectAgileArguments,
            AgileThen (
                \? (
                    AgileStep ValidateAgileProtocol,
                    AgileThen (\? (AgileStep LockAgileState, AgileStep CommitAgileMutation))
                )
            )
        )
    )

:= argument_count_is expected : bool = rust_std_env.model.argument_count_is expected
:= argument_byte_count index : i32 = rust_std_env.model.argument_byte_count index
:= argument_byte index offset : i32 = rust_std_env.model.argument_byte index offset
:= argument_owned index : string = rust_std_env.model.argument_owned index
:= argument_equals index expected : bool = rust_std_env.model.argument_equals index expected
:= i32_positive value : bool = $"0 < !value"
:= i32_digit value : bool = ? 48i32 <= value ?> value <= 57i32 |: !-
:= i32_digit_value value : i32 = $"!value - 48"
:= i32_pair_value a b : i32 = $"!a * 10 + !b"
:= i32_triple_value a b c : i32 = $"!a * 100 + !b * 10 + !c"
:= invalid_i32 () : i32 = $"-1"
:= all2 a b = ? a ?> b |: !-
:= all3 a b c = ? a ?> ? b ?> c |: !- |: !-
:= all4 a b c d = ? a ?> ? b ?> ? c ?> d |: !- |: !- |: !-

:~ agile_usage_error () : i32 = $'rig_agile_routes::rig_agile_usage_error()' : i32
:= agile_edit_route () : i32 = $'rig_agile_routes::rig_agile_edit_route()' : i32
:= agile_ask_route () : i32 = $'rig_agile_routes::rig_agile_ask_route()' : i32
:= agile_begin_route () : i32 = $'rig_agile_routes::rig_agile_begin_route()' : i32
:= agile_set_route () : i32 = $'rig_agile_routes::rig_agile_set_route()' : i32
:= agile_check (~root : string) : i32 = $"rig_agile_state::agile_check_owned(!root.as_ref())"
:= agile_lease_status (~root : string) : i32 = $"rig_agile_state::agile_lease_status_owned(!root.as_ref())"
:= agile_handoff (~root : string) : i32 = $"rig_handoff_render::handoff_render_owned(!root.as_ref())"
:= agile_record (~root : string) : i32 = $"rig_agile_state::agile_record_owned(!root.as_ref())"
:~ agile_argument_count () : i32 =
    := count = env.host_argument_count ()
    ? count > 2i32 ?> count - 2i32 |: 0i32

:= agile_root_only (run : string -> i32) : i32 =
    ? argument_count_is 2i32 ?> run (argument_owned 1i32) |: agile_usage_error ()
:= agile_with_root (route : () -> i32) : i32 = ? 2i32 <= agile_argument_count () ?> route () |: agile_usage_error ()
:= agile_arity_route (accepted : bool) (route : () -> i32) : i32 = ? accepted ?> route () |: agile_usage_error ()
:= agile_either_arity a b : bool = ? argument_count_is a ?> !+ |: argument_count_is b
:= set_with_author () : bool = ? argument_count_is 7i32 ?> ((argument_owned 5i32) = "--as") |: !-
:= set_flag (index : i32) : bool = ? (argument_owned index) = "--expect" ?> !+ |: (argument_owned index) = "--as"
:= set_with_expect () : bool =
    ? argument_count_is 7i32
    ?> set_flag 5i32
    |? argument_count_is 9i32
    ?> set_flag 5i32 && set_flag 7i32 && (argument_owned 5i32) <> (argument_owned 7i32)
    |: !-
:= agile_set_author_error () : i32 =
    := message =
            "agile set records no author (only agile note does); drop --as "
            ++# (argument_owned 6i32)
            ++# ", or add a note with --as to say who moved "
            ++# (argument_owned 2i32)
    agile_mutation_error message
:= todos_recording () : bool = rust_std_env.model.argument_flag_present 4i32 "--record"
:= next_claims () : bool = rust_std_env.model.argument_flag_present 4i32 "--any"
:= claim_queue_call (s : agile_subcommand) : bool =
    ?= s ?|
    | AgileNext => next_claims ()
    | AgileClaim | AgileRelease => !+
    | _ => !-

:~ state_lock_released (~root : string) : () =
    := _ = rig_agile_lock.lock.lock_released root
    ()

:~ state_lock_held (writes : bool) (~root : string) : bool = ? writes ?> rig_agile_lock.lock.lock_taken root |: !+

:~ state_lock_done (writes : bool) (~root : string) : () = ? writes ?> state_lock_released root |: ()

:~ state_lock_refused () : i32 =
    := message = "agile state/agile.spi stayed locked by a live writer for 5 min; nothing written, run the call again"
    agile_mutation_error message

:~ terms_report (~root : string) : i32 =
    $'{ let path = std::env::var("RIG_AGILE_TERMS").ok().filter(|p| \!p.is_empty()) \
        .or_else(|| std::env::var("LOCALAPPDATA").ok().map(|base| format\!("{base}/rig/agile-terms.txt"))) \
        .unwrap_or_default(); \
        let rules = std::fs::read_to_string(&path).unwrap_or_default(); \
        let state = std::path::Path::new(&*!root).join("state"); \
        let mut lines = Vec::new(); \
        for entry in std::fs::read_dir(&state).into_iter().flatten().flatten() { \
            if entry.path().extension().and_then(|e| e.to_str()) == Some("spi") { \
                let text = std::fs::read_to_string(entry.path()).unwrap_or_default(); \
                lines.extend(text.lines().map(str::to_owned)); } } \
        let mut count = 0; \
        for line in rules.lines() { if let Some((kind, pattern)) = line.split_once(char::from(9u8)) { \
            count += 1; \
            let hits = regex::RegexBuilder::new(pattern).case_insensitive(true).build() \
                .map(|rule| lines.iter().filter(|row| rule.is_match(row)).count().to_string()) \
                .unwrap_or_else(|_| "invalid".to_owned()); \
            println\!("rig agile terms rule kind={kind} state_lines={hits} pattern={pattern}"); } } \
        println\!("rig agile terms ok rules={count} source={path}"); 0i32 }' : i32

:= agile_route (subcommand : agile_subcommand) : i32 =
    ?= subcommand ?|
    | AgileInit =>
        agile_arity_route (agile_either_arity 2i32 4i32) \ () =>
            $"agile_backlog_scaffold::rig_agile_init_run()"
    | AgileDialect =>
        agile_arity_route (argument_count_is 3i32) \ () =>
            $"agile_backlog_scaffold::rig_agile_dialect_run()"
    | AgileBegin => agile_arity_route (argument_count_is 3i32) agile_begin_route
    | AgileLease | AgileStatus => agile_root_only agile_lease_status
    | AgileHandoff => agile_root_only agile_handoff
    | AgileList => agile_with_root \ () => agile_task_tree.epic_tree.list_routed ()
    | AgileCheck => agile_root_only agile_check
    | AgileRecord => agile_root_only agile_record
    | AgileSet =>
        agile_arity_route (argument_count_is 5i32 || set_with_expect ()) agile_set_route
    | AgileAdd =>
        agile_arity_route (8i32 <= agile_argument_count ()) \ () =>
            $"agile_task_creation::rig_agile_add_run()"
    | AgileGap => agile_with_root \ () => rig_agile_gap.intake.gap_entry ()
    | AgileChanges => agile_with_root \ () => rig_agile_changes.changes.changes_run ()
    | AgileAsk => agile_with_root \ () => agile_ask_route ()
    | AgileReceipts => agile_with_root \ () => rig_agile_receipts.verify.verify_run ()
    | AgileTerms => agile_root_only terms_report
    | AgileEdit => agile_arity_route (agile_either_arity 5i32 7i32) agile_edit_route
    | AgileShow => agile_with_root \ () => $"agile_task_inspection::rig_agile_show_run()"
    | AgilePlan => agile_with_root \ () => $"agile_planning_rollup::rig_agile_planning_rollup_run()"
    | AgileMigrateTags => agile_with_root \ () => $"agile_planning_migration::rig_agile_migrate_tags_run()"
    | AgileMigrateActivity => agile_with_root \ () => rig_agile_activity_migration.migration.migrate_run ()
    | AgileSprint => agile_with_root \ () => rig_agile_sprint.sprint.sprint_run ()
    | AgileLint => agile_with_root \ () => rig_agile_lint.lint_cli.lint_run ()
    | AgileGate => agile_with_root \ () => rig_agile_gate.gate.gate_run ()
    | AgileCadence => agile_with_root \ () => rig_agile_cadence.cadence.cadence_run ()
    | AgileNote => agile_arity_route (agile_either_arity 4i32 6i32) \ () => $"agile_task_notes::rig_agile_note_run()"
    | AgileNoteEdit => agile_with_root \ () => $"agile_note_edit::rig_agile_note_edit_run()"
    | AgileNotes =>
        agile_arity_route (argument_count_is 4i32) \ () => $"agile_title_notes::rig_agile_notes_from_title_run()"
    | AgileRename => agile_arity_route (argument_count_is 4i32) \ () => $"agile_task_rename::rig_agile_rename_run()"
    | AgileSeal => agile_with_root \ () => $"agile_note_seal::rig_agile_seal_run()"
    | AgileTodos =>
        agile_with_root \ () =>
            ? todos_recording ()
            ?> $"agile_todo_record::rig_agile_todos_record_run()"
            |: $"agile_todo_scan::rig_agile_todos_run()"
    | AgileNext =>
        agile_with_root \ () =>
            ? next_claims () ?> $"agile_claim_cli::rig_agile_claim_run()" |: $"agile_task_next::rig_agile_next_run()"
    | AgileClaim | AgileRelease => agile_with_root \ () => $"agile_claim_cli::rig_agile_claim_run()"
    | AgileClaims => agile_with_root \ () => $"agile_claim_cli::rig_agile_claims_run()"
    | AgileRoots => agile_with_root \ () => $"agile_todo_roots::rig_agile_roots_run()"
    | AgileLinks => agile_with_root \ () => $"agile_memory_links::rig_agile_links_run()"
    | AgileWip => agile_with_root \ () => $"agile_todo_merge::rig_agile_wip_run()"
    | AgileViews | AgileView | AgileViewAdd => agile_with_root \ () => $"agile_task_views::rig_agile_views_run()"

:~ term_warning () : string =
    $'std::rc::Rc::<str>::from({ let path = std::env::var("RIG_AGILE_TERMS").ok().filter(|p| \!p.is_empty()) \
        .or_else(|| std::env::var("LOCALAPPDATA").ok().map(|base| format\!("{base}/rig/agile-terms.txt"))) \
        .unwrap_or_default(); \
        let rules = std::fs::read_to_string(&path).unwrap_or_default(); \
        let written = std::env::args().skip(4).collect::<Vec<_>>().join(" "); \
        let mut found = Vec::new(); \
        for line in rules.lines() { if let Some((kind, pattern)) = line.split_once(char::from(9u8)) { \
            if let Ok(rule) = regex::RegexBuilder::new(pattern).case_insensitive(true).build() { \
                if let Some(hit) = rule.find(&written) { \
                    found.push(format\!("{kind} {:?} at {}", hit.as_str(), hit.start())); } \
            } } } \
        if found.is_empty() { String::new() } else { format\!("rig agile warning: operational terms in the text \
            ({}); the committed backlog holds project facts only, rules from {path}", found.join("; ")) } })' : string

:~ terms_warned () : i32 =
    := warning = term_warning ()
    ? warning = "" ?> 0i32 |: workspace_primitives.console.stderr_line warning

:~ agile_entry () : i32 =
    ?= agile_subcommand_of (argument_owned 0i32) ?|
    | AgileKnown subcommand =>
        ?= agile_root_operand (argument_owned (agile_root_index subcommand)) ?|
        | RootFlagged flag =>
            := name = argument_owned 0i32
            agile_mutation_error ($'rig_command_help::rig_agile_root_flag_refusal(&*!name, &*!flag)' : string)
        | RootNamed root =>
            := writes = agile_state_access.access.writes_named (argument_owned 0i32) || claim_queue_call subcommand
            ? state_lock_held writes root ?>
                := _ = ? writes ?> terms_warned () |: 0i32
                := code = agile_route subcommand
                state_lock_done writes root
                code
            |? claim_queue_call subcommand ?>
                := refused = "rig agile " ++# argument_owned 0i32 ++# " refused reason=contention"
                := _ = workspace_primitives.console.stdout_line refused
                4i32
            |: state_lock_refused ()
    | AgileUnknownName => agile_usage_error ()

:= main () : i32 =
    export "rig_agile_run" ((\ () => agile_entry ()) : () -> i32)
    := _ = typed_agile_plan ()
    := _ = agile_entry ()
    0i32
