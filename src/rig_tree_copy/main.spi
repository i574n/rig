:= main () : i32 =
    terminal.emit_runtime ()
    export
        "rig_tree_copy_entry_allowed_binding"
        ((\ (depth, entries) => model.entry_allowed depth entries) : i32 * i32 -> i32)
    export
        "rig_tree_copy_remaining_binding"
        ((\ (entries, unused) => model.remaining_entries entries) : i32 * i32 -> i32)
    0i32
