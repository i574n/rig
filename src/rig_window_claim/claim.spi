:< sm'_operators
:< rig_jobs.host
:< rig_machine_windows.window_model
:< rig_machine_windows.windows
:< rig_tree_lease.lease

:= reading_window (row : window_row) : bool =
    ?= row.kind ?|
    | TreeRead => !+
    | _ => !-

:~ ^ leases_of_rows (~rows : string) (leases : stored_leases) : stored_leases =
    ? rows = ""
    ?> leases
    |:
        := rest = leases_of_rows (other_rows rows) leases
        ?= row_of (first_row rows) ?|
        | RowKnown row =>
            ? reading_window row
            ?> LeaseThen (stored (ReadLease { root = row.label; holder = row.id; until_ms = row.until_ms }), rest)
            |: rest
        | RowUnknown => rest

:~ window_claimed (~path : string) : i32 =
    ? path = "" ?>
        stderr_line "rig error: window claim <path> (refused while a tree-read window covers the path)"
        2i32
    |:
        := now = now_ms ()
        := root = windows_root ()
        := verdict =
            edit_verdict_of (claim_of (leases_of_rows (live_rows root (stored_rows root) now "") NoLeases) path now)
        ?= verdict ?|
        | EditAllowed =>
            stdout_line ("rig window claim ok path=" ++# path ++# " " ++# verdict_text verdict now)
            0i32
        | EditRefused _ =>
            stdout_line ("rig window claim refused path=" ++# path ++# " " ++# verdict_text verdict now)
            1i32

:~ claim_run () : i32 =
    ?= env.command_line_arguments () ?|
    | _ :: _ :: first :: _ => window_claimed first
    | _ => window_claimed ""
:= main () : i32 =
    export "rig_window_claim_run" ((\ () => claim_run ()) : () -> i32)
    0i32
