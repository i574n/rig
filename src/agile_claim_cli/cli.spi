///- --package .
:# cli static =
    :< sm'_operators
    :< agile_claim_model.claim

:< sm'_operators
:< agile_note_model.model
:< workspace_primitives.clock
:< workspace_primitives.console
:< agile_claim_model.claim
:< agile_claim_api.api
:< agile_claim_request.request

:== claim_order =
    {
        next : bool
        grab : bool
        release : bool
        verb : string
        item : string
        lane : string
        ttl_min : i32
        paths : list string
    }

:~ ^ listed_paths (paths : array_base string) (at : i32) (found : list string) : list string =
    ? at < 0i32 ?> found |: listed_paths paths (at - 1i32) (am'.index_base at paths :: found)

:~ order_of (parsed : parsed_request) : claim_order =
    := paths = listed_paths parsed.paths (am'.length_base parsed.paths - 1i32) []
    := item, lane = parsed.item, parsed.lane
    {
        next = parsed.next
        grab = parsed.grab
        release = parsed.release
        verb = parsed.verb
        item = item
        lane = lane
        ttl_min = parsed.ttl_min
        paths = paths
    }
:~ anchored (~cwd : string) (~glob : string) : string =
    := slashed = sm'.replace "\\" "/" glob
    := rooted = sm'.starts_with "/" slashed || sm'.index_of ":/" slashed = 1i32
    := size : i32 = sm'.length slashed
    := local = ? sm'.starts_with "./" slashed ?> sm'.substring 2i32 (size - 2i32) slashed |: slashed
    ? rooted ?> slashed |: sm'.replace "\\" "/" cwd ++# "/" ++# local

:~ ^ repository_of (~directory : string) : string =
    := marker = directory ++# "/.git"
    ? file_system.directory_exists marker || file_system.file_exists marker
    ?> directory
    |:
        := cut = sm'.last_index_of "/" directory
        ? cut <= 0i32 ?> "" |: repository_of (sm'.substring 0i32 cut directory)

:~ claims_base (~cwd : string) (~root : string) : string =
    := absolute = sm'.trim_end_suffix "/" (anchored cwd root)
    := repository = repository_of absolute
    ? repository = "" ?> sm'.replace "\\" "/" cwd |: repository
:~ live_claims (~lane : string) (now_ms : u64) (claims : list claim) : list claim =
    claims |> listm'.filter (\ (c : claim) => now_ms < c.expires_ms && decliner c = "" && (lane = "" || c.owner = lane))

:~ local_clock (unix_ms : u64) : string =
    sm'.replace " " "" (sm'.replace ")" "" (sm'.replace " (" "" (local_stamp (utc_stamp unix_ms))))

:~ lane_wip (~root : string) (~lane : string) : i32 =
    := _, rows = claims_loaded root
    listm.length (live_claims lane (unix_ms ()) (claims_of_text rows))

:~ receipt
    (~verb : string) (~item : string) (~owner : string) (expires_ms : u64) (ttl_min : i32) (wip : i32) (rank : i32)
    : string
    =
    := head = "rig agile " ++# verb ++# " ok claimed=" ++# item ++# " owner=" ++# owner
    := expiry = " expires=" ++# utc_stamp expires_ms ++# " expires_local=" ++# local_clock expires_ms
    := ranked = ? rank > 0i32 ?> " rank=" ++# sm'.show rank |: ""
    head ++# expiry ++# " ttl_min=" ++# sm'.show ttl_min ++# " wip=" ++# sm'.show wip ++# ranked

:~ printed (lines : list string) (code : i32) : i32 =
    := wrote = stdout_line (sm'.concat_list "\n" (lines |> listm'.filter (\ (line : string) => line <> "")))
    ? wrote <> 0i32 ?> wrote |: code

:~ claim_answered
    (r : claim_order) (~root : string) (stored : bool * string) (~wsjf : string) (~active : string) (~known : string)
    (~live : string)
    : i32
    =
    := existed, rows = stored
    := now_ms = unix_ms ()
    := kind, item, owner, expires, rank, wip, detail, change =
        ? r.next ?> claim_next r.lane r.ttl_min wsjf active live rows now_ms
        |? r.release ?> claim_release r.item r.lane r.ttl_min rows now_ms
        |:
            := paths = sm'.concat_list "," r.paths
            claim_lease r.item r.lane r.ttl_min paths wsjf known live rows now_ms
    := failed = \ (~problem : string) => stderr_failure ("agile " ++# r.verb ++# " rejected: " ++# problem)
    := application =
        {
            root = root
            existed = existed
            original = rows
            change = change
            item = item
            owner = owner
            expires_ms = expires
            paths = detail
            known = known
        }
    := problem =
        agile_claim_store.store.applied_claims (
            (;[ application ] : array agile_claim_store.store.claim_application) |> am'.base
        )
    ? problem <> "" ?> failed problem
    |:
        ?= outcome_of kind ?|
        | OutcomeGranted =>
            := where = ? detail = "" ?> "paths none" |: "paths " ++# detail
            := line = receipt r.verb item owner expires r.ttl_min wip rank ++# " lane_wip=" ++# sm'.show (lane_wip root owner)
            printed [ line; claim_item_lines root item; where ] 0i32
        | OutcomeRefused => printed [ "rig agile claim refused id=" ++# r.item ++# " reason=" ++# detail ] 5i32
        | OutcomeNone =>
            := text = "rig agile next ok claimed=none reason=" ++# detail ++# " wip=" ++# sm'.show wip
            printed [ text ] 3i32
        | OutcomeDropped =>
            := head = "rig agile release ok id=" ++# r.item ++# " owner=" ++# r.lane
            := mine = " lane_wip=" ++# sm'.show (lane_wip root r.lane)
            printed [ head ++# " released=" ++# detail ++# " wip=" ++# sm'.show wip ++# mine ] 0i32
        | OutcomeReleaseRefused => printed [ "rig agile release refused id=" ++# r.item ++# " reason=" ++# detail ] 5i32
        | OutcomeUnknown => failed ("no open task with id " ++# r.item)
:~ listed_next (~root : string) (~lane : string) (~wsjf : string) (~active : string) : i32 =
    := _, rows = claims_loaded root
    := picked = agile_claim_listing.listing.listed_ids (rows, lane, wsjf, active, unix_ms ())
    := picks = am'.to_list_base' picked |> listm'.unbox
    := count : i32 = listm.length picks
    := head = "rig agile next ok listed=" ++# sm'.show count ++# " lane=" ++# lane ++# " claimed=none"
    := hint = "take one: rig agile claim " ++# root ++# " <ID> --as " ++# lane ++# " (or next --claim takes the first)"
    printed (head :: listm.append (picks |> listm.map (claim_item_lines root)) [ ? count > 0i32 ?> hint |: "" ]) 0i32

:~ claim_line (now_ms : u64) (c : claim) : string =
    := left = (c.expires_ms - now_ms) / 60000u64
    := where = ? c.paths = [] ?> "none" |: sm'.concat_list "," c.paths
    := head = "  " ++# c.item ++# "  " ++# c.owner ++# "  expires=" ++# utc_stamp c.expires_ms ++# " local=" ++# local_clock c.expires_ms
    head ++# " left_min=" ++# sm'.show left ++# "  paths=" ++# where

:~ claims_listed (~root : string) (~lane : string) : i32 =
    := _, rows = claims_loaded root
    := now_ms = unix_ms ()
    := live = live_claims lane now_ms (claims_of_text rows)
    := count : i32 = listm.length live
    := head = "rig agile claims ok live=" ++# sm'.show count ++# (? lane = "" ?> "" |: " lane=" ++# lane)
    printed (listm.append (live |> listm.map (claim_line now_ms)) [ head ]) 0i32

:~ claims_run () : i32 =
    ?= env.command_line_arguments () ?|
    | _ :: _ :: root :: [] => claims_listed root ""
    | _ :: _ :: root :: flag :: lane :: [] ?& flag = "--as" => claims_listed root lane
    | _ => stderr_failure "agile claims: usage: claims <root> [--as <lane>]"

:~ claim_requested (~root : string) (asked : claim_order) : i32 =
    := base = claims_base (file_system.get_current_directory ()) root
    := r = { asked ?| paths = asked.paths |> listm.map (anchored base) }
    := found, ranked, started, known, live = claim_ranking root
    := mine = ? asked.next ?> agile_team_lane.lane.lane_items (root, asked.lane) |: ""
    := wsjf, active = ? asked.next ?> agile_claim_listing.listing.lane_order (ranked, started, mine) |: ranked, started
    ? found = !-
    ?> stderr_failure ("agile " ++# asked.verb ++# ": state/agile.spi is missing")
    |? asked.next && asked.grab |> not
    ?> listed_next root asked.lane wsjf active
    |: claim_answered r root (claims_loaded root) wsjf active known live

:~ claim_run () : i32 =
    ?= env.command_line_arguments () ?|
    | _ :: word :: root :: words =>
        := gather = \ (kept : array string) (item : string) => kept ++ ;[ item ]
        := parsed = am'.index_base 0i32 (request_parsed (word, words |> listm.fold gather ;[] |> am'.base))
        ? parsed.refusal <> ""
        ?> stderr_failure ("agile " ++# word ++# ": " ++# parsed.refusal)
        |: claim_requested root (order_of parsed)
    | _ => stderr_failure "agile: usage: next|claim|release <root> ..."


///> rust
:# relative_globs_are_anchored_at_the_callers_directory =
    := windows = anchored "C:\\home\\git\\kit" "src/agile/**"
    testing.expect (windows = "C:/home/git/kit/src/agile/**") windows
    testing.expect (anchored "/home/x" "./lib/a.spi" = "/home/x/lib/a.spi") (anchored "/home/x" "./lib/a.spi")
    testing.expect (anchored "/home/x" "/etc/y" = "/etc/y" && anchored "/home/x" "D:/z/**" = "D:/z/**") "absolute"

///> rust
:# claims_lists_live_leases_by_lane =
    := a = { item = "A-1"; owner = "kit"; expires_ms = 120000u64; paths = [ "src/a/**" ] }
    := b = { item = "B-2"; owner = "x"; expires_ms = 500u64; paths = [] }
    := d = { item = "C-3"; owner = "~kit"; expires_ms = 120000u64; paths = [] }
    testing.expect (live_claims "" 1000u64 [ a; b; d ] = [ a ]) "expired leases and declines are not live claims"
    testing.expect (live_claims "x" 1000u64 [ a; b; d ] = []) "a lane filter keeps only that lane's leases"
    testing.expect (live_claims "kit" 1000u64 [ a; b; d ] = [ a ]) "the lane's own lease"
    := line = claim_line 0u64 a
    testing.expect (sm'.starts_with "  A-1  kit  expires=" line && sm'.ends_with " left_min=2  paths=src/a/**" line) line
    testing.expect (sm'.ends_with "paths=none" (claim_line 0u64 d)) "a lease without paths says none"

///> rust
:# relative_globs_are_anchored_at_the_backlog_repository =
    := temp = sm'.trim_end_suffix "/" (sm'.replace "\\" "/" (file_system.get_temp_path ()))
    := repository = temp ++# "/rig-claims-base-" ++# sm'.show (unix_ms ())
    := _ = file_system.directory_create_all (repository ++# "/.git")
    := _ = file_system.directory_create_all (repository ++# "/team/backlog")
    := elsewhere = claims_base "C:/elsewhere" (repository ++# "/team/backlog")
    := relative = claims_base (repository ++# "/team") "backlog"
    file_system.directory_delete true repository
    testing.expect (elsewhere = repository) "an absolute root anchors at its repository, not the shell"
    testing.expect (relative = repository) "a relative root resolves against the shell first"
    testing.expect (repository_of "/rig-claims-no-repository/a" = "") "no repository above"
    testing.expect (claims_base "/shell" "/rig-claims-no-repository/a" = "/shell") "without a repository the shell anchors"

:= main () : i32 =
    export "rig_agile_claim_run" ((\ () => claim_run ()) : () -> i32)
    export "rig_agile_claims_run" ((\ () => claims_run ()) : () -> i32)
    0i32
