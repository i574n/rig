:= claim_ranking (~root : string) : bool * string * string * string * string =
    $'agile_claim_rank::rig_claim_ranking(&*!root)' : bool * string * string * string * string
:= claim_item_lines (~root : string) (~id : string) : string = $'agile_claim_item::rig_claim_item_lines(&*!root, &*!id)' : string
:= claim_next (~lane : string) (ttl : i32) (~wsjf : string) (~active : string) (~live : string) (~rows : string) (now : u64)
    : string * string * string * u64 * i32 * i32 * string * string
    =
    $'agile_claim_queue::rig_claim_next(&*!lane, !ttl, &*!wsjf, &*!active, &*!live, &*!rows, !now)'
    : string * string * string * u64 * i32 * i32 * string * string
:= claim_lease
    (~item : string) (~lane : string) (ttl : i32) (~paths : string) (~wsjf : string) (~known : string) (~live : string)
    (~rows : string) (now : u64)
    : string * string * string * u64 * i32 * i32 * string * string
    =
    $'agile_claim_lease::rig_claim_lease(&*!item, &*!lane, !ttl, &*!paths, &*!wsjf, &*!known, &*!live, &*!rows, !now)'
    : string * string * string * u64 * i32 * i32 * string * string
:= claim_release (~item : string) (~lane : string) (ttl : i32) (~rows : string) (now : u64)
    : string * string * string * u64 * i32 * i32 * string * string
    =
    $'agile_claim_release::rig_claim_release(&*!item, &*!lane, !ttl, &*!rows, !now)'
    : string * string * string * u64 * i32 * i32 * string * string
:= claims_loaded (~root : string) : bool * string = $'agile_claim_store::rig_claims_loaded(&*!root)' : bool * string
:= planning_selected (~records : string) (~id : string) (~load : string) (~assignee : string) : bool =
    $'agile_planning_filters::rig_agile_planning_selected(&!records, &!id, &!load, &!assignee)' : bool
