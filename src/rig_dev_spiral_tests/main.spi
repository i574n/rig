:< registry
:< sm'_operators
:< failures
:< batches

:~ ^ selected_notebooks
    (root : string) (names : string) (separator : string) (notebooks : list spiral_test_notebook) (~acc : string)
    : string
    =
    ?= notebooks ?|
    | [] => acc
    | entry :: rest =>
        := chosen = selects names separator entry.package && notebook.present root entry.relative
        selected_notebooks root names separator rest (
            ? chosen ?> (? acc = "" ?> entry.relative |: acc ++# "\n" ++# entry.relative) |: acc
        )

:~ ^ announced (~listed : string) (index : i32) : i32 =
    ? index < notebook.line_count listed ?>
        := _ = notebook.announce (notebook.line_at listed index)
        announced listed (index + 1i32)
    |: 0i32

:~ reported (failures : failed_notebooks) (code : i32) : i32 =
    ?= failures ?|
    | NoFailures =>
        := _ = ? code = 0i32 ?> () |: $'eprintln\!("spiral notebooks: every notebook reported passing, \
            but the batch exited {}", !code)' : ()
        code
    | _ =>
        := listed = failure_list failures ""
        := count = failure_count failures 0i32
        := _ = $'eprintln\!("spiral notebooks failed ({}): {}", !count, &*!listed)' : ()
        first_code failures 1i32

:~ attempt_rows (~attempt : string) : list string =
    sm'.split_list "\n" attempt |> listm'.filter (\ (row : string) => row <> "")

:~ ran_fully (~attempt : string) (~file : string) : bool =
    attempt_rows attempt |> listm'.exists' (\ (row : string) => row = file ++# "\t\tpartial") |> not

:~ failed_in (~attempt : string) (~file : string) (~test : string) : bool =
    attempt_rows attempt |> listm'.exists' (\ (row : string) => sm'.starts_with (file ++# "\t" ++# test ++# "\t") row)

:~ cleared (attempts : list string) (~row : string) : bool =
    ?= sm'.split_list "\t" row ?|
    | file :: test :: _ =>
        attempts |> listm'.exists' (\ (a : string) => ran_fully a file && (test = "" || failed_in a file test |> not))
    | _ => !-

:~ daemon_only_and_cleared (attempts : list string) : bool =
    := rows = attempts |> listm.fold (\ (acc : list string) (a : string) => listm.append acc (attempt_rows a)) []
    := genuine = rows |> listm'.exists' (\ (row : string) => sm'.contains "\treal\t" row)
    genuine |> not && rows <> [] && (rows |> listm'.exists' (\ (row : string) => cleared attempts row |> not) |> not)

:~ real_failures_printed (~attempt : string) : () =
    := shown = \ (row : string) => sm'.contains "\treal\t" row || sm'.ends_with "\t\tpartial" row
    := line = \ (row : string) => "spiral notebooks: failed " ++# sm'.replace "\t" "  " row
    attempt_rows attempt |> listm'.filter shown |> listm.iter (\ (row : string) => console.write_error_line (line row))

:~ ^ chunk_outcome
    (root : string) (target : string) (chunk : string) (timeout : u64) (attempt : i32) (seen : list string)
    : notebook.batch_outcome
    =
    := outcome = notebook.run_batch root target chunk timeout
    := attempts = listm.append seen [ notebook.failure_rows chunk (notebook.batch_text outcome) ]
    ? notebook.batch_code outcome = 0i32 || notebook.batch_daemon_failed outcome |> not
    ?> outcome
    |? daemon_only_and_cleared attempts
    ?>
        := _ = $'eprintln\!("spiral notebooks: every daemon-failed test passed in another full attempt")' : ()
        notebook.batch_passed ()
    |? attempt < 4i32
    ?>
        := _ = $'eprintln\!("spiral notebooks: the compiler daemon did not answer; attempt {}", !attempt + 1)' : ()
        chunk_outcome root target chunk timeout (attempt + 1i32) attempts
    |: outcome

:~ ^ batches_run
    (root : string) (target : string) (timeout : u64) (chunks : list string) (failures : failed_notebooks) (code : i32)
    : i32
    =
    ?= chunks ?|
    | [] => reported failures code
    | chunk :: rest =>
        := outcome = chunk_outcome root target chunk timeout 1i32 []
        := batch = notebook.batch_code outcome
        := _ = ? batch <> 0i32 ?> real_failures_printed (notebook.failure_rows chunk (notebook.batch_text outcome)) |: ()
        := failed = failures_of (notebook.batch_failed outcome) 0i32 (? batch = 0i32 ?> 1i32 |: batch) failures
        batches_run root target timeout rest failed (? code = 0i32 ?> batch |: code)

:~ run_registered
    (root : string) (target : string) (names : string) (separator : string) (dry : bool) (timeout : u64)
    : i32
    =
    := listed = selected_notebooks root names separator (registered ()) ""
    ? dry
    ?> announced listed 0i32
    |? listed = ""
    ?> 0i32
    |:
        := ordered = \ (kept : list string) (chunk : string) => chunk :: kept
        := chunks = chunks_from 32i32 (sm'.split_list "\n" listed) "" 0i32 [] |> listm.fold ordered []
        batches_run root target timeout chunks NoFailures 0i32

:= main () : i32 =
    export
        "rig_dev_spiral_tests_run"
        (
            \ (root, target, names, separator, dry, timeout) => run_registered root target names separator dry timeout
            : string * string * string * string * bool * u64 -> i32
        )
    0i32
