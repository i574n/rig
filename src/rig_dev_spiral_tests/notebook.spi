:= present (root : string) (relative : string) : bool =
    $'std::path::Path::new(&*!root).join(&*!relative).is_file()' : bool

:= announce (relative : string) : i32 =
    $'{ std::io::Write::write_all(&mut std::io::stdout(),format\!("spiral test blocks \
        {}\n",&*!relative).as_bytes()).unwrap(); 0i32 }' : i32

:! batch_outcome = $'(i32, std::rc::Rc<str>, bool, std::rc::Rc<str>)'

:~ run_batch (root : string) (target : string) (relatives : string) (timeout : u64) : batch_outcome =
    $'{ let root=std::path::Path::new(&*!root); let target=std::path::Path::new(&*!target); \
        let cells_root=std::env::var_os("RIG_SPIRAL_CELLS").or_else(|| \
        std::env::var_os("KIT_SPIRAL_CELLS")).map(std::path::PathBuf::from).or_else(|| \
        std::env::var_os("RIG_SPIRAL_BUNDLE").or_else(|| std::env::var_os("KIT_SPIRAL_BUNDLE")).map(|bundle| \
        std::path::PathBuf::from(bundle).join("..").join("..").join("cells"))).unwrap_or_else(|| \
        root.join("..").join("spiral").join("apps").join("cells")); \
        let relatives=(&*!relatives).lines().map(str::to_owned).collect::<Vec<_>>(); \
        let reports_dir=target.join("spiral-tests"); let _=std::fs::create_dir_all(&reports_dir); \
        let kit=target.join("debug").join(format\!("kit{}",std::env::consts::EXE_SUFFIX)); \
        let drives_cli=relatives.iter().any(|relative| std::fs::read_to_string(root.join(relative)).map(|text| \
            text.lines().next().unwrap_or("").contains("rig_cli_check")).unwrap_or(false)); \
        if drives_cli { let _=std::process::Command::new("cargo").current_dir(root.join("src")) \
            .args(["build","--locked","-p","rig-cli","--target-dir"]).arg(target).status(); } \
        let port=std::net::TcpListener::bind("127.0.0.1:0").ok().and_then(|listener| listener.local_addr().ok()) \
            .map(|address| address.port() as u32).unwrap_or(20000+std::process::id()%10000); \
        let mut command=std::process::Command::new("pwsh"); \
        command.current_dir(root).arg("-NoProfile").arg("-File").arg(cells_root.join("spi").join("run_notebook.ps1")); \
        for relative in &relatives { command.arg("--path").arg(root.join(relative)); \
        } command.arg("--output-dir").arg(&reports_dir).arg("--no-html").arg("--gate").env("RIG_BIN_UNDER_TEST", \
        &&kit).env("KIT_BIN_UNDER_TEST", &kit).env("SPIRAL_CELLS_WARM","0").env("SPIRAL_CELLS_MEMO","0").env("SPIRAL_CELLS_PER_TEST","0").env_remove("S\
        PIRAL_CELLS_COMPILER").env("SPIRAL_CELLS_COMPILER_PORT",port.to_string()); \
        let bounded=(!timeout).saturating_mul(relatives.len().max(1) as u64); let stdout_handle=std::io::stdout(); \
        let stderr_handle=std::io::stderr(); let streamed=rig_process_streaming::run_bounded_streaming(&mut \
        command,bounded,None,|kind,bytes| match kind { rig_process_streaming::ProcessStreamKind::Stdout => { let mut \
        out=stdout_handle.lock(); std::io::Write::write_all(&mut out,bytes).and_then(|_| std::io::Write::flush(&mut \
        out)).map_err(|error| error.to_string()) } rig_process_streaming::ProcessStreamKind::Stderr => { let mut \
        err=stderr_handle.lock(); std::io::Write::write_all(&mut err,bytes).and_then(|_| std::io::Write::flush(&mut \
        err)).map_err(|error| error.to_string()) } }); match streamed { Ok(capture) => { let code=if \
        matches\!(capture.termination,rig_process_streaming::ProcessTermination::TimedOut) { 124 } else { \
        capture.status.code().unwrap_or(1) }; let quote=char::from(34u8); \
        let failed_key=format\!("{quote}failed{quote}:"); let file_key=format\!("{quote}file{quote}:{quote}"); \
        let text=String::from_utf8_lossy(&capture.stdout).replace(char::from(92u8),"/").to_lowercase(); \
        let reports=text.lines().filter_map(|line| line.strip_prefix("spiral-tests file ")).map(|json| { let \
        failed=json.split(failed_key.as_str()).nth(1).map(|rest| rest.chars().take_while(|c| \
        c.is_ascii_digit()).collect::<String>()).unwrap_or_default(); \
        let file=json.split(file_key.as_str()).nth(1).and_then(|rest| \
        rest.split(quote).next()).unwrap_or("").to_owned(); (file,failed) }).collect::<Vec<_>>(); \
        let failing=relatives.iter().filter(|relative| { let wanted=relative.replace(char::from(92u8),"/").to_lowercas\
        e(); match reports.iter().find(|(file,_)| file.ends_with(&wanted)) { Some((_,failed)) => failed.as_str() \!= \
        "0", None => true } }).cloned().collect::<Vec<_>>(); \
        let daemon=["never answers the handshake","is already used by another program","compiler connection failed"]; \
        let infra=code \!= 0 && daemon.iter().any(|marker| text.contains(marker)); \
        (code,std::rc::Rc::<str>::from(failing.join("\n")),infra,std::rc::Rc::<str>::from(text.as_str())) } \
        Err(error) => { let _=std::io::Write::write_all(&mut std::io::stderr(),error.as_bytes()); \
        (2,std::rc::Rc::<str>::from(relatives.join("\n")),false,std::rc::Rc::<str>::from("")) } } }' : batch_outcome

:= batch_code (outcome : batch_outcome) : i32 = $'!outcome.0' : i32
:= batch_failed (outcome : batch_outcome) : string = $'!outcome.1.clone()' : string
:= batch_daemon_failed (outcome : batch_outcome) : bool = $'!outcome.2' : bool
:= batch_text (outcome : batch_outcome) : string = $'!outcome.3.clone()' : string
:= batch_passed () : batch_outcome =
    $'(0i32, std::rc::Rc::<str>::from(""), false, std::rc::Rc::<str>::from(""))' : batch_outcome

:~ failure_rows (~relatives : string) (~text : string) : string =
    $'std::rc::Rc::<str>::from({ let quote = char::from(34u8); let text = &*!text; let mut rows = Vec::new(); \
        let file_key = format\!("{quote}file{quote}:{quote}"); \
        let daemon = ["never answers the handshake", "is already used by another program", \
            "compiler connection failed"]; \
        for relative in (&*!relatives).lines() { \
            let wanted = relative.replace(char::from(92u8), "/").to_lowercase(); \
            let report = text.lines().filter_map(|line| line.strip_prefix("spiral-tests file ")).filter(|json| \
                json.split(file_key.as_str()).nth(1).and_then(|rest| rest.split(quote).next()) \
                .map(|file| file.ends_with(&wanted)).unwrap_or(false)).last(); \
            let Some(json) = report else { rows.push(format\!("{wanted}\t\tpartial")); continue; }; \
            let number = |key: &str| json.split(format\!("{quote}{key}{quote}:").as_str()).nth(1) \
                .map(|rest| rest.chars().take_while(|c| c.is_ascii_digit()).collect::<String>()) \
                .and_then(|digits| digits.parse::<i64>().ok()).unwrap_or(0); \
            if number("executed") < number("discovered") { rows.push(format\!("{wanted}\t\tpartial")); } \
            let messages = json.split(format\!("{quote}failed_messages{quote}:").as_str()).nth(1) \
                .and_then(|rest| rest.split(char::from(125u8)).next()).unwrap_or(""); \
            let names = json.split(format\!("{quote}failed_tests{quote}:").as_str()).nth(1) \
                .and_then(|rest| rest.split(char::from(93u8)).next()).unwrap_or(""); \
            let bracket = char::from(91u8); \
            for name in names.split(char::from(44u8)).map(|n| n.trim_matches(|c: char| c == quote || c == bracket)) { \
                if name.is_empty() { continue; } \
                let message = messages.split(format\!("{quote}{name}{quote}:{quote}").as_str()).nth(1) \
                    .and_then(|rest| rest.split(quote).next()).unwrap_or(""); \
                let kind = if daemon.iter().any(|marker| message.contains(marker)) { "daemon" } else { "real" }; \
                let clipped = message.chars().take(240).collect::<String>(); \
                rows.push(format\!("{wanted}\t{name}\t{kind}\t{clipped}")); } } \
        rows.join("\n") })' : string
:= line_count (text : string) : i32 = sm'.line_count text
:= line_at (text : string) (index : i32) : string = sm'.line_at index text
