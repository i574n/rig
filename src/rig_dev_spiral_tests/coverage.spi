///- --package .
:< sm'_operators

:~ package_dir () : string =
    $'std::rc::Rc::<str>::from({ let mut base = std::env::current_dir().unwrap_or_default(); \
        while \!base.join("src").join("rig_dev_spiral_tests").is_dir() { if \!base.pop() { break; } } \
        base.join("src").to_string_lossy().into_owned() })' : string

:~ test_files (~src : string) : list string =
    := listed =
        $'std::rc::Rc::<str>::from({ let mut found = Vec::new(); \
            for dir in std::fs::read_dir(&*!src).into_iter().flatten().flatten() { \
                let name = dir.file_name().to_string_lossy().into_owned(); \
                if name == "target" || name == "spiral" || \!dir.path().is_dir() { continue; } \
                for file in std::fs::read_dir(dir.path()).into_iter().flatten().flatten() { \
                    let path = file.path(); \
                    if path.extension().and_then(|e| e.to_str()) \!= Some("spi") { continue; } \
                    let tested = std::fs::read_to_string(&path).map(|text| text.lines() \
                        .any(|line| line == "///> rust" || line.starts_with("///> rust "))).unwrap_or(false); \
                    if tested { found.push(format\!("src/{}/{}", name, file.file_name().to_string_lossy())); } } } \
            found.sort(); found.join("\n") })' : string
    ? listed = "" ?> [] |: sm'.split_list "\n" listed

:~ text_of (~path : string) : string =
    $'std::rc::Rc::<str>::from(std::fs::read_to_string(&*!path).unwrap_or_default().replace(char::from(13u8), ""))'
    : string

:~ registered_files (~src : string) : list string =
    := marker = "relative = \""
    := relative = \ (line : string) =>
        := at = sm'.index_of marker line
        := rest = sm'.substring (at + sm'.length marker) (sm'.length line - at - sm'.length marker) line
        sm'.substring 0i32 (sm'.index_of "\"" rest) rest
    sm'.split_list "\n" (text_of (src ++# "/rig_dev_spiral_tests/registry.spi"))
    |> listm'.filter (\ (line : string) => sm'.contains marker line)
    |> listm.map relative

:= baseline_files () : list string =
    [
        "src/rig_handoff_degrade/degrade.spi"
        "src/rig_handoff_degrade/inputs.spi"
        "src/rig_ready_rank/rank.spi"
    ]

:~ listed_in (rows : list string) (~path : string) : bool = listm'.exists' (\ (row : string) => row = path) rows

///> rust
:# every_test_file_is_registered_or_in_the_baseline_and_the_baseline_only_shrinks =
    := src = package_dir ()
    := registered = registered_files src
    := waiting = baseline_files ()
    := files = test_files src
    := unlisted = files |> listm'.filter (\ (f : string) => listed_in registered f |> not && listed_in waiting f |> not)
    testing.expect (unlisted = []) ("register these test files in registry.spi: " ++# sm'.concat_list ", " unlisted)
    := stale = waiting |> listm'.filter (\ (f : string) => listed_in registered f || listed_in files f |> not)
    testing.expect (stale = []) ("drop these rows from baseline_files in coverage.spi: " ++# sm'.concat_list ", " stale)
    testing.expect (listm.length files > 300i32 && listm.length registered > 100i32) "the scan found the source tree"
