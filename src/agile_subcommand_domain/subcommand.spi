///- --package .
:# subcommand static =
    :< sm'_operators

:< sm'_operators


:| agile_subcommand =
    | AgileInit
    | AgileBegin
    | AgileLease
    | AgileStatus
    | AgileHandoff
    | AgileList
    | AgileCheck
    | AgileRecord
    | AgileSet
    | AgileAdd
    | AgileGap
    | AgileEdit
    | AgileShow
    | AgilePlan
    | AgileMigrateTags
    | AgileMigrateActivity
    | AgileSprint
    | AgileLint
    | AgileGate
    | AgileCadence
    | AgileNote
    | AgileNoteEdit
    | AgileRedact
    | AgileNotes
    | AgileRename
    | AgileSeal
    | AgileTodos
    | AgileNext
    | AgileClaim
    | AgileRelease
    | AgileClaims
    | AgileRoots
    | AgileLinks
    | AgileWip
    | AgileViews
    | AgileView
    | AgileViewAdd
    | AgileDialect
    | AgileReceipts
    | AgileTerms
    | AgileChanges
    | AgileAsk
    | AgileBatch

:= agile_subcommand_spec = function
    | AgileInit => { name = "init"; shape = "<root> [--dialect symbols|words]" }
    | AgileBegin => { name = "begin"; shape = "<root> <title>" }
    | AgileLease => { name = "lease"; shape = "<root>" }
    | AgileStatus => { name = "status"; shape = "<root>" }
    | AgileHandoff => { name = "handoff"; shape = "<root>" }
    | AgileList =>
        {
            name = "list"
            shape =
                "<root> [all|Planned|Active|Blocked|Paused|Done|Dropped] [--team <team>] [--tag <tag>] [--prefix <ID "
                ^^ "prefix>] [--words <w1,w2>] [--open] [--ready] [--blocked] [--sort priority|difficulty|progress] "
                ^^ "[--load light|medium|heavy|none] [--assignee agent|pair|user|none] [--json]"
        }
    | AgileCheck => { name = "check"; shape = "<root> [--compiler <absolute>]" }
    | AgileRecord => { name = "record"; shape = "<root>" }
    | AgileSet =>
        {
            name = "set"
            shape =
                "<root> <id> <progress|-> <Planned|Active|Blocked|Paused|Done|Dropped> [--expect <status>] "
                ^^ "[--as <lane>]"
        }
    | AgileAdd =>
        {
            name = "add"
            shape =
                "<root> <ID> <Epic|Feature|Story|TaskKind> <P0..P5> <D0..D8> <title> <tags> [--estimate <m>] "
                ^^ "[--load <l>] [--assignee <a>] [--deps <A,B>] [--note <text> --as <author>]"
        }
    | AgileGap =>
        {
            name = "gap"
            shape = "<root> <title> --verb <verb> --as <lane> [--exit <n>] [--argv <text>] [--cwd <dir>]"
        }
    | AgileEdit =>
        {
            name = "edit"
            shape =
                "<root> <id> <title|title-append|kind|priority|difficulty|deps|tags|estimate|load|assignee> <value> | "
                ^^ "<root> <id> --wait <train|item|lane|user|job|when>:<value> | --wait-remove <kind>:<value> | "
                ^^ "--wait --clear | --parent <EPIC> | --after <ID> | --after --clear | --split milestones | "
                ^^ "--asked <yyyy-mm-dd> --ask \"<scope>; done when <criterion>\" | --asked --clear | "
                ^^ "<field> <value> --expect <current value>"
        }
    | AgileShow => { name = "show"; shape = "<root> <id> [--json]" }
    | AgilePlan => { name = "plan"; shape = "<root> [--json]" }
    | AgileMigrateTags => { name = "migrate-tags"; shape = "preview|apply <root>" }
    | AgileMigrateActivity => { name = "migrate-activity"; shape = "preview|apply <root>" }
    | AgileSprint =>
        {
            name = "sprint"
            shape =
                "start <root> <id> <days> <goal> [--items A,B] | show <root> [<id>] | add|drop <root> <id> <item> | "
                ^^ "close <root> <id> | velocity <root> [--last n]"
        }
    | AgileLint => { name = "lint"; shape = "<root> [--census | --team <team>]" }
    | AgileGate => { name = "gate"; shape = "<root> --team <team> --as <lane>" }
    | AgileCadence =>
        { name = "cadence"; shape = "<root> [--hours n] [--days n | --since yyyy-mm-dd] [--team t] [--round h]" }
    | AgileNote => { name = "note"; shape = "<root> <id> <text> [--as <author>]" }
    | AgileNoteEdit =>
        {
            name = "note-edit"
            shape =
                "<root> <id> <note-number> <text> [--as <author>] [--append] [--expect-at <iso> | --expect-prefix "
                ^^ "<text>]"
        }
    | AgileRedact => { name = "redact"; shape = "<root> --terms <file outside the backlog> --as <lane> [--apply]" }
    | AgileNotes => { name = "notes"; shape = "from-title <root> <id>" }
    | AgileRename => { name = "rename"; shape = "<root> <old-id> <new-id>" }
    | AgileSeal => { name = "seal"; shape = "<root> [--dry-run]" }
    | AgileTodos => { name = "todos"; shape = "<root> [<path>...] [--json] [--tagged | --id <ID>] | <root> --record" }
    | AgileNext =>
        {
            name = "next"
            shape =
                "<root> [--as main|subagent] [--team <team>] [--tag <tag>] [--prefix <ID prefix>] [--words "
                ^^ "<w1,w2>] [--open] [--ready] [--blocked] [--load <loads>] [--fits] [count] | "
                ^^ "<root> --any --as <lane> [--ttl <minutes>] (claims the top free item)"
        }
    | AgileClaim => { name = "claim"; shape = "<root> <ID> --as <lane> [--paths <glob,glob>] [--ttl <minutes>]" }
    | AgileRelease => { name = "release"; shape = "<root> <ID> --as <lane>" }
    | AgileClaims => { name = "claims"; shape = "<root> [--as <lane>] [--team <team>]" }
    | AgileRoots => { name = "roots"; shape = "<root> [add|drop <path>...]" }
    | AgileLinks => { name = "links"; shape = "<root> --memory <dir> [--json]" }
    | AgileWip => { name = "wip"; shape = "<root>" }
    | AgileViews => { name = "views"; shape = "<root>" }
    | AgileView => { name = "view"; shape = "<root> <name> [extra flags...]" }
    | AgileViewAdd => { name = "view-add"; shape = "<root> <name> <list|next> [flags...]" }
    | AgileDialect => { name = "dialect"; shape = "<root> <symbols|words>" }
    | AgileChanges => { name = "changes"; shape = "<root> --since <8h|30m|iso> [--team <team>]" }
    | AgileReceipts => { name = "receipts"; shape = "<root> verify <file>" }
    | AgileTerms => { name = "terms"; shape = "<root>" }
    | AgileAsk => { name = "ask"; shape = "<root> <id> \"<scope>; done when <criterion>\"" }
    | AgileBatch => { name = "batch"; shape = "<root> --file <plan.tsv> [--as <lane>] [--dry-run]" }

:| agile_parsed =
    | AgileKnown : agile_subcommand
    | AgileUnknownName

:~ agile_subcommand_of (~input : string) : agile_parsed =
    union_reflection.cases.union_cases_fold
        \ parsed (subcommand : agile_subcommand) =>
            ? (input = (agile_subcommand_spec subcommand).name)
            ?> AgileKnown subcommand
            |: parsed
        AgileUnknownName

:~ agile_subcommand_shape (~input : string) : string =
    union_reflection.cases.union_cases_fold
        (\ found (subcommand : agile_subcommand) =>
            := spec = agile_subcommand_spec subcommand
            ? found = "" && (input = spec.name) ?> spec.shape |: found)
        ""

:= agile_subcommand_usage (separator : string) : string =
    union_reflection.cases.union_cases_joined
        (\ (subcommand : agile_subcommand) =>
            := spec = agile_subcommand_spec subcommand
            !!!!StaticStringConcat(spec.name, !!!!StaticStringConcat(" ", spec.shape)))
        separator

:~ agile_subcommand_known (~input : string) : i32 =
    ?= agile_subcommand_of input ?|
    | AgileKnown _ => 1i32
    | AgileUnknownName => 0i32

:| state_access =
    | ReadsState
    | WritesState

:= state_access_of = \|
    | AgileInit | AgileLease | AgileStatus | AgileHandoff | AgileList | AgileShow => ReadsState
    | AgilePlan | AgileNext | AgileLinks | AgileWip | AgileViews | AgileView | AgileLint => ReadsState
    | AgileGate | AgileCadence | AgileClaims | AgileReceipts | AgileTerms | AgileChanges => ReadsState
    | AgileClaim | AgileRelease | AgileBegin | AgileRecord | AgileSet | AgileAdd | AgileGap | AgileEdit => WritesState
    | AgileMigrateTags | AgileMigrateActivity | AgileNote | AgileNoteEdit | AgileNotes | AgileRename => WritesState
    | AgileSeal | AgileTodos | AgileRoots | AgileViewAdd | AgileSprint | AgileDialect | AgileCheck => WritesState
    | AgileAsk | AgileRedact => WritesState
    | AgileBatch => ReadsState

:| root_place =
    | RootLeads
    | RootAfterMode

:= agile_root_place = \|
    | AgileMigrateTags | AgileMigrateActivity | AgileSprint | AgileNotes => RootAfterMode
    | _ => RootLeads

:= agile_root_index (subcommand : agile_subcommand) : i32 =
    ?= agile_root_place subcommand ?|
    | RootLeads => 1i32
    | RootAfterMode => 2i32

:| root_operand =
    | RootNamed : string
    | RootFlagged : string

:= agile_root_operand (~argument : string) : root_operand =
    ? sm'.starts_with "--" argument ?> RootFlagged argument |: RootNamed argument

:= root_operand_shown = \|
    | RootNamed root => "root " ++# root
    | RootFlagged flag => "flag " ++# flag

:= agile_root_flag_refusal (subcommand : agile_subcommand) (~flag : string) : string =
    := spec = agile_subcommand_spec subcommand
    "agile "
    ++# spec.name
    ++# " takes <root> before any flag, got "
    ++# flag
    ++# "; usage: agile "
    ++# spec.name
    ++# " "
    ++# spec.shape

///> rust
:# a_flag_in_the_root_slot_is_refused_by_its_own_name =
    testing.expect
        (root_operand_shown (agile_root_operand "--team") = "flag --team")
        "the flag is named, not the value after it"
    testing.expect (root_operand_shown (agile_root_operand ".") = "root .") "a root passes"
    testing.expect (root_operand_shown (agile_root_operand "-x") = "root -x") "a single dash is a path"
    testing.expect
        (
            agile_root_index AgileNext = 1i32
            && agile_root_index AgileNotes = 2i32
            && agile_root_index AgileMigrateTags = 2i32
        )
        "mode words come before the root"
    testing.expect
        (
            sm'.starts_with
                "agile next takes <root> before any flag, got --team; usage: agile next <root> [--as main|subagent]"
                (agile_root_flag_refusal AgileNext "--team")
        )
        "the refusal carries the verb's usage"

///> rust
:# agile_shapes_come_from_the_union =
    testing.expect (agile_subcommand_shape "show" = "<root> <id> [--json]") "a known verb's shape"
    testing.expect (agile_subcommand_shape "nope" = "") "an unknown verb has no shape"
