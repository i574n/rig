:< rust_std_fs.model
:< agile_state_fs.model
:< sm'_operators
:< agile_note_model.model
:< workspace_primitives.files
:< agile_claim_model.claim

:= claims_path (~root : string) : string = root ++# "/state/claims.spi"
:= state_dir_of (~root : string) : string = root ++# "/state"

:~ claims_loaded (~root : string) : bool * string =
    ?= probe (unchecked (claims_path root)) ?|
    | FileMissing _ => !-, ""
    | FileReadable file => !+, loaded_string (read_text file)

:~ module_registered (~root : string) : state_write =
    := path = agile_state_fs.project.project_path_in (state_dir_of root)
    ?= probe (unchecked path) ?|
    | FileMissing _ => StateWritten
    | FileReadable file =>
        := format = agile_state_fs.project.project_format_in (state_dir_of root)
        ?= agile_state_fs.project.project_with_module format (loaded_string (read_text file)) "claims" ?|
        | agile_state_fs.project.ModuleListed => StateWritten
        | agile_state_fs.project.NoModulesSection => StateWriteFailed "the state project has no modules section to list claims in"
        | agile_state_fs.project.ModuleAdded listed =>
            ?= replace_file_checked path listed ?|
            | Replaced => StateWritten
            | problem => StateWriteFailed (file_replacement_problem problem)

:~ claims_saved (~root : string) (existed : bool) (~original : string) (~updated : string) : string =
    := path = claims_path root
    := unchanged = ? existed ?> text_equals original path |: file_exists path = !-
    := written =
        ? unchanged = !-
        ?> StateChangedSinceRead
        |:
            ?= replace_file_checked path updated ?|
            | Replaced => module_registered root
            | problem => StateWriteFailed (file_replacement_problem problem)
    ?= written ?|
    | StateWritten => ""
    | StateChangedSinceRead => "state/claims.spi changed since it was read; nothing written, run the call again"
    | StateWriteFailed reason => reason

:~ claims_applied
    (~root : string) (existed : bool) (~original : string) (~change : string) (~item : string) (~owner : string)
    (expires_ms : u64) (~paths : string) (~known : string)
    : string
    =
    := claims = claims_of_text original
    := listed_ids = sm'.split_list " " known
    := lease =
        {
            item = item
            owner = owner
            expires_ms = expires_ms
            paths =
                ? sm'.starts_with "~" owner
                ?> []
                |: sm'.split_list ";" paths |> listm'.filter \ (g : string) => g <> ""
        }
    := changed =
        ?= change_of change ?|
        | ChangeUpsert => upserted claims lease
        | ChangeRemove => released claims item
        | ChangeNone => claims
    := kept = changed |> listm'.filter (\ (c : claim) => listm'.contains c.item listed_ids)
    ? change_of change = ChangeNone ?> "" |: claims_saved root existed original (claims_text kept)

:== claim_application =
    {
        root : string
        existed : bool
        original : string
        change : string
        item : string
        owner : string
        expires_ms : u64
        paths : string
        known : string
    }

:~ applied_claims (applications : array_base claim_application) : string =
    := a = am'.index_base 0i32 applications
    claims_applied a.root a.existed a.original a.change a.item a.owner a.expires_ms a.paths a.known

:= main () : i32 =
    export "rig_claims_loaded" ((\ root => claims_loaded root) : string -> bool * string)
    export "rig_claims_applied" applied_claims
    0i32
