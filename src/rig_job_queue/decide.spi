:< sm'_operators
:< rig_jobs.host
:< rig_jobs.jobs
:< rig_job_host.queue

:~ queue_decide (~id : string) : i32 =
    := step = step_of (queued_of id)
    ?= step ?|
    | StartSupervisor =>
        := slotted = rig_job_slot.slot.slot_held_step id
        ? slotted <> 0i32 ?> slotted |: rig_job_gate.gate.held_window_step id
    | KeepWaiting => 1i32
    | _ =>
        settled_in_queue id step
        rig_job_slot.slot.slot_ticket_dropped id
        rig_job_gate.gate.held_window_dropped id
        2i32

:= main () : i32 =
    export "rig_job_queue_decide" ((\ id => queue_decide id) : string -> i32)
    0i32
